{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "generates": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "migration-tool": {
                        "description": "The migration tool used to apply migrations to the database.",
                        "type": "string",
                        "enum": [
                            "flyway"
                        ]
                    },
                    "directory": {
                        "description": "The directory to generate migrations in.",
                        "type": "string",
                        "minLength": 1
                    },
                    "schema": {
                        "description": "The schema for the partitions.",
                        "type": "string",
                        "minLength": 1,
                        "default": "public"
                    },
                    "tablespace": {
                        "description": "The tablespace for the partitions.",
                        "type": "string",
                        "minLength": 1,
                        "default": "pg_default"
                    },
                    "index_tablespace": {
                        "description": "The tablespace for the indexes.",
                        "type": "string",
                        "minLength": 1,
                        "default": "pg_default"
                    },
                    "storage_parameters": {
                        "description": "The storage parameters for the partitions.",
                        "type": "object",
                        "properties": {
                            "fillfactor": {
                                "description": "The fillfactor for the partitions.",
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 100
                            },
                            "autovacuum_enabled": {
                                "description": "Whether to enable autovacuum for the partitions.",
                                "type": "boolean",
                                "default": false
                            }
                        },
                        "additionalProperties": false,
                        "minProperties": 1,
                        "default": {}
                    },
                    "name_template": {
                        "description": "The name template for the partitions.",
                        "type": "string",
                        "examples": [
                            "{schema}__{table}__YYYY_MM_DD",
                            "{schema}__{table}__YYYY_MM"
                        ],
                        "minLength": 1
                    },
                    "interval": {
                        "description": "The partition interval.",
                        "type": "string",
                        "minLength": 1
                    },
                    "past": {
                        "description": "The number of past partitions to generate.",
                        "type": "integer",
                        "minimum": 0,
                        "default": 0
                    },
                    "future": {
                        "description": "The number of future partitions to generate.",
                        "type": "integer",
                        "minimum": 0,
                        "default": 0
                    },
                    "create_default": {
                        "description": "Whether to create default partition.",
                        "type": "boolean",
                        "default": false
                    },
                    "default_partition_name_template": {
                        "description": "The name template for the default partition.",
                        "type": "string",
                        "examples": [
                            "{schema}__{table}__default"
                        ],
                        "minLength": 1
                    },
                    "retention": {
                        "description": "The retention time interval to expire partitions containing data older than the given interval.",
                        "type": [
                            "string",
                            "null"
                        ],
                        "minLength": 1,
                        "default": "null"
                    },
                    "detach_first": {
                        "description": "Whether to detach the expired partitions first before dropping them.",
                        "type": "boolean",
                        "default": false
                    },
                    "detach_only": {
                        "description": "Whether to only detach the expired partitions.",
                        "type": "boolean",
                        "default": false
                    },
                    "detach_concurrently": {
                        "description": "Whether to detach the expired partitions concurrently.",
                        "type": "boolean",
                        "default": false
                    },
                    "skip_overlapping": {
                        "description": "Whether to skip overlapping partitions.",
                        "type": "boolean",
                        "default": false
                    },
                    "timezone": {
                        "description": "The timezone to use for the partitions.",
                        "type": "string",
                        "minLength": 1
                    },
                    "tables": {
                        "description": "List of tables to generate partitions for.",
                        "type": "array",
                        "items": {
                            "description": "The table to generate partitions for.",
                            "type": "object",
                            "properties": {
                                "table_schema": {
                                    "description": "The schema of the table.",
                                    "type": "string",
                                    "minLength": 1
                                },
                                "table_name": {
                                    "description": "The name of the table.",
                                    "type": "string",
                                    "minLength": 1
                                },
                                "partition": {
                                    "type": "object",
                                    "description": "The partition configuration for the table.",
                                    "properties": {
                                        "schema": {
                                            "description": "The schema for the partitions.",
                                            "type": "string",
                                            "minLength": 1
                                        },
                                        "tablespace": {
                                            "description": "The tablespace for the partitions.",
                                            "type": "string",
                                            "minLength": 1
                                        },
                                        "index_tablespace": {
                                            "description": "The tablespace for the indexes.",
                                            "type": "string",
                                            "minLength": 1,
                                            "default": "pg_default"
                                        },
                                        "storage_parameters": {
                                            "description": "The storage parameters for the partitions.",
                                            "type": "object",
                                            "properties": {
                                                "fillfactor": {
                                                    "description": "The fillfactor for the partitions.",
                                                    "type": "integer",
                                                    "minimum": 0,
                                                    "maximum": 100
                                                },
                                                "autovacuum_enabled": {
                                                    "description": "Whether to enable autovacuum for the partitions.",
                                                    "type": "boolean",
                                                    "default": false
                                                }
                                            },
                                            "additionalProperties": false,
                                            "minProperties": 1
                                        },
                                        "name_template": {
                                            "description": "The name template for the partitions.",
                                            "type": "string",
                                            "examples": [
                                                "{schema}__{table}__YYYY_MM_DD",
                                                "{schema}__{table}__YYYY_MM"
                                            ],
                                            "minLength": 1
                                        },
                                        "interval": {
                                            "description": "The partition interval.",
                                            "type": "string",
                                            "minLength": 1
                                        },
                                        "past": {
                                            "description": "The number of past partitions to generate.",
                                            "type": "integer",
                                            "minimum": 0
                                        },
                                        "future": {
                                            "description": "The number of future partitions to generate.",
                                            "type": "integer",
                                            "minimum": 0
                                        },
                                        "create_default": {
                                            "description": "Whether to create default partition.",
                                            "type": "boolean",
                                            "default": false
                                        },
                                        "default_partition_name_template": {
                                            "description": "The name template for the default partition.",
                                            "type": "string",
                                            "examples": [
                                                "{schema}__{table}__default"
                                            ],
                                            "minLength": 1
                                        },
                                        "retention": {
                                            "description": "The retention time interval to expire partitions containing data older than the given interval.",
                                            "type": "string",
                                            "minLength": 1
                                        },
                                        "detach_first": {
                                            "description": "Whether to detach the expired partitions first before dropping them.",
                                            "type": "boolean",
                                            "default": false
                                        },
                                        "detach_only": {
                                            "description": "Whether to only detach the expired partitions.",
                                            "type": "boolean",
                                            "default": false
                                        },
                                        "detach_concurrently": {
                                            "description": "Whether to detach the expired partitions concurrently.",
                                            "type": "boolean",
                                            "default": false
                                        },
                                        "skip_overlapping": {
                                            "description": "Whether to skip overlapping partitions.",
                                            "type": "boolean",
                                            "default": false
                                        },
                                        "timezone": {
                                            "description": "The timezone to use for the partitions.",
                                            "type": "string",
                                            "minLength": 1
                                        }
                                    },
                                    "additionalProperties": false
                                },
                                "template": {
                                    "description": "The template table to replicate objects such as constraints, indexes, triggers from.",
                                    "type": [
                                        "object",
                                        "string"
                                    ],
                                    "enum": [
                                        "DEFAULT_PARTITION",
                                        "CURRENT_PARTITION",
                                        "LATEST_PARTITION"
                                    ],
                                    "properties": {
                                        "table_schema": {
                                            "description": "Schema of the template table.",
                                            "type": "string",
                                            "minLength": 1
                                        },
                                        "table_name": {
                                            "description": "Name of the template table.",
                                            "type": "string",
                                            "minLength": 1
                                        }
                                    },
                                    "required": [
                                        "table_schema",
                                        "table_name"
                                    ],
                                    "additionalProperties": false
                                }
                            },
                            "required": [
                                "table_schema",
                                "table_name"
                            ],
                            "additionalProperties": false
                        },
                        "minItems": 1
                    },
                    "groups": {
                        "description": "Configure groups for tables. By default we create one file per partitioned table, this controls if you want everything in one file (*) or you want specific table partitions in one file ",
                        "type": "object",
                        "additionalProperties": {
                            "type": "object",
                            "properties": {
                                "patterns": {
                                    "description": "",
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "uniqueItems": true,
                                    "minItems": 1
                                },
                                "exclude-patterns": {
                                    "description": "",
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "uniqueItems": true,
                                    "minItems": 1
                                }
                            },
                            "anyOf": [
                                {
                                    "required": [
                                        "patterns"
                                    ]
                                },
                                {
                                    "required": [
                                        "exclude-patterns"
                                    ]
                                }
                            ],
                            "additionalProperties": false
                        },
                        "minProperties": 1
                    }
                },
                "required": [
                    "migration-tool",
                    "directory",
                    "tables"
                ],
                "additionalProperties": false
            }
        }
    },
    "required": [
        "generates"
    ],
    "additionalProperties": false
}
