#!/bin/bash

# shellcheck source=src/bin/pgp-shell-helpers
source "$(dirname "${BASH_SOURCE[0]}")/pgp-shell-helpers"

PGP_MIN_POSTGRES_VERSION=14

usage()
{
    cat <<EOF
    ${0##*/}

    Installs major PostgreSQL version, psql client, optionally creates a cluster, starts the cluster and applies init directory if provided.

    OPTIONS:
      -v  the postgres version to use (Default: ${PGP_MIN_POSTGRES_VERSION}, must be at least ${PGP_MIN_POSTGRES_VERSION})
      -m  the mode to use (Default: ephemeral, options: ephemeral, external)
      -i  the init directory to apply (Optional) (supports .sh, .sql and .sql.gz)
      -h  show this help message.

    SAMPLE USAGE:
        ${0##*/} -i initdir
        ${0##*/} -v 17 -i initdir
        ${0##*/} -v 17 -m ephemeral -i initdir
EOF
}

while getopts "v:m:i:h" option; do
    case "${option}" in
        v)
            pg_major_version="${OPTARG}"
            ;;
        m)
            PGP_MODE="${OPTARG}"
            ;;
        i)
            init_dir="${OPTARG}"
            ;;
        h)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
done

set -euo pipefail

configure_database_environment

export PGP_CLUSTER_NAME="${PGP_CLUSTER_NAME:-pgpartix}"

pg_major_version="${pg_major_version:-${PGP_PG_MAJOR_VERSION:-${PGP_MIN_POSTGRES_VERSION}}}"
pgp_mode="${PGP_MODE:-ephemeral}"
init_dir=${init_dir:-${PGP_INIT_DIR:-}}
# export PGP_PG_MAJOR_VERSION="${pg_major_version}"

if (( pg_major_version < PGP_MIN_POSTGRES_VERSION )); then
  echo "Error: PostgreSQL major version must be at least ${PGP_MIN_POSTGRES_VERSION}" >&2
  exit 1
fi

# Install PostgreSQL
sudo apt.postgresql.org.sh -i -p -v "${pg_major_version}"

case "${pgp_mode}" in
    ephemeral)
        echo "INFO: Creating PostgreSQL cluster ${PGP_CLUSTER_NAME} for PostgreSQL ${pg_major_version}"

        # shellcheck disable=SC2086 # Allow word splitting for additional options
        sudo pg_createcluster --start \
            "${pg_major_version}" \
            "${PGP_CLUSTER_NAME}" \
            --port="${PGPORT:-5432}" \
            ${PGP_CREATE_OPTIONS:-} \
            -- -A trust

        if [[ -n "${init_dir}" && ! -d "${init_dir}" ]]; then
            echo "ERROR: The provided init directory '${init_dir}' does not exist or is not a directory." >&2
            exit 1
        fi

        if [[ -d "${init_dir}" ]]; then
            echo "INFO: Applying init scripts from ${init_dir}"

            find "${init_dir}" -type f \
                \( -iname "*.sh" -o -iname "*.sql" -o -iname "*.sql.gz" \) \
                | sort \
                | while IFS= read -r file; do
                    case "${file}" in
                        *.sh)
                            if [[ -x "${file}" ]]; then
                                "${file}"
                            else
                                # shellcheck source=/dev/null
                                . "${file}"
                            fi
                            ;;
                        *.sql)
                            # KCOV_EXCL_START
                            psql \
                                --username=postgres \
                                --dbname=postgres \
                                --variable "ON_ERROR_STOP=1" \
                                --quiet \
                                --no-psqlrc \
                                -f "${file}"
                            # KCOV_EXCL_STOP
                            ;;
                        *.sql.gz)
                            # KCOV_EXCL_START
                            gunzip -c "${file}" |
                                psql \
                                    --username=postgres \
                                    --dbname=postgres \
                                    --variable "ON_ERROR_STOP=1" \
                                    --quiet \
                                    --no-psqlrc
                            # KCOV_EXCL_STOP
                            ;;
                    esac
                done

            echo "INFO: Applied init scripts from ""${init_dir}"""
        fi
        ;;

    external)
        echo "INFO: Using external PostgreSQL database"
        ;;

    *)
        echo "ERROR: Invalid PGP_MODE '${pgp_mode}'. Expected 'ephemeral' or 'external'." >&2
        exit 2
        ;;
esac
