#!/bin/bash

# shellcheck source=src/bin/pgp-shell-helpers
source "$(dirname "${BASH_SOURCE[0]}")/pgp-shell-helpers"

usage()
{
    cat <<EOF
    ${0##*/}

    Starts the bundled PostgreSQL version and applies an init directory if provided.

    OPTIONS:
      -i  the init directory to apply (Optional) (supports .sh, .sql and .sql.gz)
      -h  show this help message.

    SAMPLE USAGE:
        ${0##*/} -i initdir
EOF
}

while getopts "i:h" option; do
    case "${option}" in
        i)
            init_dir="${OPTARG}"
            ;;
        h)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
done

set -euo pipefail

if ! command -v initdb > /dev/null; then
    postgres_bin_dir="$(pg_config --bindir)"
    export PATH="${postgres_bin_dir}:${PATH}"
fi

configure_database_environment

init_dir=${init_dir:-${PGP_INIT_DIR:-}}

if [[ -n "${init_dir}" && ! -d "${init_dir}" ]]; then
    echo "ERROR: The provided init directory '${init_dir}' does not exist or is not a directory." >&2
    exit 1
fi

if [[ -e "${PGDATA}/PG_VERSION" ]]; then
    echo "ERROR: '${PGDATA}' already contains a PostgreSQL cluster." >&2
    exit 1
fi

echo "INFO: Creating ephemeral PostgreSQL cluster"

# KCOV_EXCL_START
initdb \
    --username=postgres \
    --auth=trust \
    --no-instructions

pg_ctl \
    --log="${PGDATA}/postgresql.log" \
    --options="-h localhost" \
    --options="-p 5432" \
    --wait \
    start

# KCOV_EXCL_STOP

if [[ -d "${init_dir}" ]]; then
    echo "INFO: Applying init scripts from ${init_dir}"

    find "${init_dir}" -type f \
        \( -iname "*.sh" -o -iname "*.sql" -o -iname "*.sql.gz" \) \
        | sort \
        | while IFS= read -r file; do
            case "${file}" in
                *.sh)
                    if [[ -x "${file}" ]]; then
                        "${file}"
                    else
                        # shellcheck source=/dev/null
                        . "${file}"
                    fi
                    ;;
                *.sql)
                    # KCOV_EXCL_START
                    psql \
                        --username=postgres \
                        --dbname=postgres \
                        --variable "ON_ERROR_STOP=1" \
                        --quiet \
                        --no-psqlrc \
                        -f "${file}"
                    # KCOV_EXCL_STOP
                    ;;
                *.sql.gz)
                    # KCOV_EXCL_START
                    gunzip -c "${file}" |
                        psql \
                            --username=postgres \
                            --dbname=postgres \
                            --variable "ON_ERROR_STOP=1" \
                            --quiet \
                            --no-psqlrc
                    # KCOV_EXCL_STOP
                    ;;
            esac
        done

    echo "INFO: Applied init scripts from ${init_dir}"
fi
