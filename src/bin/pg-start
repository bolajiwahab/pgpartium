#!/bin/bash

usage()
{
    echo "
    ${0##*/}

    Installs major PostgreSQL version, psql client, optionally creates a cluster, starts the cluster and applies init script if provided.

    OPTIONS:
      -v  the postgres version to use (Required)
      -i  the init script to apply (Optional)
      -h  show this help message.

    SAMPLE USAGE:
        ${0##*/} -v 17 -i init.sql
        PGP_PG_MAJOR_VERSION=17 INIT_SCRIPT=init.sql ${0##*/}
"
}

while getopts "v:i:h" option
do
    case "${option}" in
        v)
            pg_major_version="${OPTARG}"
            ;;
        i)
            init_dir="${OPTARG}"
            ;;
        h | *)
            usage
            exit 0
            ;;
    esac
done

set -euo pipefail

pg_major_version=${pg_major_version:-${PGP_PG_MAJOR_VERSION:-}}
init_dir=${init_dir:-${PGP_INIT_DIR:-}}

# Ensure postgres version is provided.
if [[ -z "${pg_major_version}" ]]; then
    usage
    exit 1
fi

if (( pg_major_version < 14 )); then
  echo "Error: PostgreSQL major version must be at least 14" >&2
  exit 1
fi

# Install PostgreSQL
apt.postgresql.org.sh -i -v "${pg_major_version}"

if [[ -z ${NO_CLUSTER+yes} ]]; then
    echo "INFO: Creating PostgreSQL cluster"
    pg_createcluster --start "${pg_major_version}" pgpartium -- -A trust

    # Ensure the provided init directory exists and is a directory
    if [[ -n "${init_dir}" && ! -d "${init_dir}" ]]; then
        echo "The provided init directory ${init_dir} does not exist or is not a directory" >&2
        exit 1
    fi

    if [[ -d "${init_dir}" ]]; then
        echo "INFO: Applying init scripts from ${init_dir}"

        find "${init_dir}" -type f \( -iname "*.sh" -o -iname "*.sql" -o -iname "*.sql.gz" \) \
        | sort \
        | while IFS= read -r file; do
            case "${file}" in
                *.sh)
                    if [[ -x "${file}" ]]; then
                        "${file}"
                    else
                        # shellcheck source=/dev/null
                        . "${file}"
                    fi
                    ;;
                *.sql)
                    psql --username=postgres \
                        --dbname=postgres \
                        -v "ON_ERROR_STOP=1" \
                        --quiet \
                        --no-psqlrc -f "${file}"
                    ;;
                *.sql.gz)
                    gunzip -c "${file}" |
                    psql --username=postgres \
                        --dbname=postgres \
                        -v "ON_ERROR_STOP=1" \
                        --quiet \
                        --no-psqlrc
                    ;;
            esac
        done

        echo "INFO: Applied init scripts from ""${init_dir}"""
    fi
fi
