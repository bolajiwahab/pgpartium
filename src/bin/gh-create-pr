#!/bin/bash

usage() {
    echo "
    ${0##*/}

    Creates or updates a pull request on github.

    OPTIONS:
      -b  the branch name to use (Default: partition-maintenance)
      -t  the title of the pull request (Default: chore: partition maintenance)
      -m  the commit message (Default: chore: partition maintenance)
      -h  show this help message.

    SAMPLE USAGE:
        ${0##*/} -b generate-partitions
"
}

while getopts "b:t:m:h" option; do
    case "${option}" in
    b)
        branch="${OPTARG}"
        ;;
    t)
        title="${OPTARG}"
        ;;
    m)
        commit_msg="${OPTARG}"
        ;;
    h | *)
        usage
        exit 0
        ;;
    esac
done

set -euo pipefail

if git diff --quiet -- && [ -z "$(git ls-files --others --exclude-standard)" ]; then
    echo "INFO: No changes detected. Exiting..."
    exit 0
fi

branch=${branch:-"partition-maintenance"}
title=${title:-"chore: partition maintenance"}
commit_msg=${commit_msg:-"${title}"}

full_branch="pgpartium/${branch}"
base_branch=$(git remote show origin | grep 'HEAD branch' | awk '{print $NF}')

# Set up git config
git config --global user.email "github-actions[bot]@users.noreply.github.com"
git config --global user.name "github-actions[bot]"

# Fetch latest base branch from remote
git fetch origin "${base_branch}"

# Create or reset our branch
git checkout -B "${full_branch}" "origin/${base_branch}"

git add -A
git commit -m "${commit_msg}"

# Push to remote
git push origin "${full_branch}" --force

# Generate body of PR
log=$(cat /src/partition_maintenance.log)
body="""
This PR is auto-generated by pgpartium.

Performs partition maintenance.

${log}
"""

# Create PR
PR_URL="$(gh pr list --head "${full_branch}" --state open --json url --jq .[].url)"
if [[ -n "${PR_URL}" ]]; then
    echo "INFO: PR already exists -> ${PR_URL}...."
    echo "INFO: Editing the body of ${PR_URL}"
    gh pr edit "${PR_URL}" --body "${body}"
else
    echo "INFO: Creating PR..."
    gh pr create --base "${base_branch}" \
        --head "${full_branch}" \
        --title "${title}" \
        --body "${body}"
    echo "INFO: PR created"
fi
