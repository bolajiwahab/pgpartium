#!/bin/bash

function usage() {
    echo "
    ${0##*/}

    Set up infrastructure.

    OPTIONS:
      -h  show this help message.

    SAMPLE USAGE:
        PGP_USER=user PGP_PASSWORD=password PGP_HOST=host PGP_PORT=port PGP_DATABASE=database ${0##*/}"
}

while getopts "h" option; do
    case "${option}" in
    h)
        usage
        exit 0
        ;;
    ?)
        usage
        exit 1
        ;;
    esac
done

set -euo pipefail

# Setup infrastructure
find /src/sql -type f -iname "*.sql" -print0 | sort -z | xargs -0 printf -- ' -f %s' |
    PGUSER="${PGP_USER:-postgres}" PGPASSWORD="${PGP_PASSWORD:-postgres}" PGDATABASE="${PGP_DATABASE:-postgres}" \
    PGHOST="${PGP_HOST:-localhost}" PGPORT="${PGP_PORT:-5432}" PGOPTIONS='--client_min_messages=warning' xargs \
    psql --quiet \
        -v "ON_ERROR_STOP=1" \
        --single-transaction
