#!/bin/bash

# shellcheck source=src/bin/pgp-shell-helpers
source "$(dirname "${BASH_SOURCE[0]}")/pgp-shell-helpers"

function usage() {
    cat <<EOF
    ${0##*/}

    Set up infrastructure.

    OPTIONS:
      -h  show this help message.

    SAMPLE USAGE:
        ${0##*/}
EOF
}

while getopts "h" option; do
    case "${option}" in
    h)
        usage
        exit 0
        ;;
    ?)
        usage
        exit 1
        ;;
    esac
done

set -euo pipefail

configure_database_environment

# Setup infrastructure
find /src/sql -type f -iname "*.sql" -print0 | sort -z | xargs -0 printf -- ' -f %s' |
    PGOPTIONS='--client_min_messages=warning' xargs \
    psql --quiet \
        --variable "ON_ERROR_STOP=1" \
        --single-transaction
