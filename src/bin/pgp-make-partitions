#!/bin/bash

function usage() {
    echo "
    ${0##*/}

    Make partitions for partitioned tables.

    OPTIONS:
      -c  Path to a configuration file or directory containing configuration files (Default: .)
      -h  show this help message.

    SAMPLE USAGE:
        PGP_USER=user PGP_PASSWORD=password PGP_HOST=host PGP_PORT=port PGP_DATABASE=database ${0##*/} -c config.yaml
        PGP_USER=user PGP_PASSWORD=password PGP_HOST=host PGP_PORT=port PGP_DATABASE=database ${0##*/} -c config_directory
"
}

while getopts "c:h" option; do
    case "${option}" in
    c)
        config_path="${OPTARG}"
        ;;
    h)
        usage
        exit 0
        ;;
    ?)
        usage
        exit 1
        ;;
    esac
done

set -euo pipefail

config_path=${config_path:-.}

if [[ ! -e "${config_path}" ]]; then
    echo "The provided config path '${config_path}' does not exist" >&2
    exit 1
fi

function cleanup() {
    rm -rf "${temp_migration_directory}"
    rm -rf "${temp_error_directory}"
}

function validate_config() {
    local config="$1"
    local schema="$2"

    # if ! jsonschema "${schema}" <<< "$(yq -o=json "${config}")"; then
    #     echo "ERROR: Config file ${config} is invalid" >&2
    #     exit 1
    # fi
    ls "${config}"
    if ! check-jsonschema --schemafile "${schema}" <(yq -o=json "${config}"); then
        echo "ERROR: Config file ${config} is invalid" >&2
        exit 1
    fi
}

function make_partitions() {
    local config="$1"
    validate_config "${config}" /src/schema.json

    # Set defaults.
    export DEFAULT_TABLESPACE=null
    export DEFAULT_PAST=0
    export DEFAULT_FUTURE=0
    export DEFAULT_RETENTION=null
    export DEFAULT_SKIP_OVERLAPPING=false
    export DEFAULT_IDEMPOTENT=false
    export DEFAULT_STORAGE_PARAMETERS=null
    export DEFAULT_TIMEZONE="Etc/UTC"
    export DIRECTORY="."

    # Extract global configs.
    GLOBAL_PARTITION_SCHEMA="$(yq '.lifecycle.partition.schema' "${config}")"
    GLOBAL_PARTITION_NAME_TEMPLATE="$(yq '.lifecycle.partition.naming.template' "${config}")"
    GLOBAL_PAST="$(yq '.lifecycle.partition.past // strenv(DEFAULT_PAST)' "${config}")"
    GLOBAL_FUTURE="$(yq '.lifecycle.partition.future // strenv(DEFAULT_FUTURE)' "${config}")"
    GLOBAL_INTERVAL="$(yq '.lifecycle.partition.interval' "${config}")"
    GLOBAL_START_TIMESTAMP="$(yq '.lifecycle.partition.start_timestamp' "${config}")"
    GLOBAL_RETENTION="$(yq '.lifecycle.partition.retention // strenv(DEFAULT_RETENTION)' "${config}")"
    GLOBAL_DEFAULT_PARTITION_NAME_TEMPLATE="$(yq '.lifecycle.partition.default.naming.template' "${config}")"
    GLOBAL_SKIP_OVERLAPPING="$(yq '.lifecycle.partition.skip_overlapping // strenv(DEFAULT_SKIP_OVERLAPPING)' "${config}")"
    GLOBAL_IDEMPOTENT="$(yq '.lifecycle.partition.idempotent // strenv(DEFAULT_IDEMPOTENT)' "${config}")"
    GLOBAL_PARTITION_TABLESPACE="$(yq '.lifecycle.partition.tablespace // strenv(DEFAULT_TABLESPACE)' "${config}")"
    GLOBAL_INDEX_TABLESPACE="$(yq '.lifecycle.partition.index.tablespace // strenv(DEFAULT_TABLESPACE)' "${config}")"

    GLOBAL_PARTITION_STORAGE_PARAMETERS="$(yq -o=json '.lifecycle.partition.storage_parameters // (strenv(DEFAULT_STORAGE_PARAMETERS) | fromjson)' "${config}")"
    GLOBAL_INDEX_STORAGE_PARAMETERS="$(yq -o=json '.lifecycle.partition.index.storage_parameters // (strenv(DEFAULT_STORAGE_PARAMETERS) | fromjson)' "${config}")"

    export GLOBAL_PARTITION_TABLESPACE GLOBAL_INDEX_TABLESPACE GLOBAL_PARTITION_SCHEMA \
           GLOBAL_PARTITION_NAME_TEMPLATE GLOBAL_PAST GLOBAL_FUTURE GLOBAL_INTERVAL GLOBAL_START_TIMESTAMP GLOBAL_RETENTION \
           GLOBAL_DEFAULT_PARTITION_NAME_TEMPLATE GLOBAL_SKIP_OVERLAPPING GLOBAL_PARTITION_STORAGE_PARAMETERS \
           GLOBAL_INDEX_STORAGE_PARAMETERS GLOBAL_IDEMPOTENT

    directory="$(yq '.lifecycle.directory // strenv(DIRECTORY)' "${config}")"
    timezone="$(yq '.lifecycle.partition.timezone // strenv(DEFAULT_TIMEZONE)' "${config}")"

    # Store failed table names.
    declare -A failed_tables=()

    # Staging area.
    temp_migration_directory="$(mktemp -d)"
    temp_error_directory="$(mktemp -d)"

    trap cleanup ERR

    # Stage current migrations in staging area.
    echo "INFO: Staging current migrations"
    cp -a "${directory}/." "${temp_migration_directory}/"

    # Setup infrastructure.
    echo "INFO: Setting up infrastructure"
    pgp-setup-infrastructure

    # Process each partitioned table.
    while read -r table; do
        table_schema="$(yq '.schema' <<< "${table}")"
        table_name="$(yq '.name' <<< "${table}")"

        output_file_template="$(yq '.output_file_template // "pgpartium_output.sql"' <<< "${table}")"

        description="$(yq '.description.make // "Make partitions for {table_schema}_{table_name}"' <<< "${table}")"
        # Replace table_schema and table_name placeholders in the description.
        description="${description//\{table_schema\}/$table_schema}"
        description="${description//\{table_name\}/$table_name}"

        partition_schema="$(yq '.partition.partition_schema // strenv(GLOBAL_PARTITION_SCHEMA)' <<< "${table}")"
        # If no schema is provided either in the partition config or in the global config, default to table schema.
        if [[ "${partition_schema}" == "null" ]]; then
            echo "INFO: Partition schema not provided. Defaulting to table schema '${table_schema}'"
            partition_schema="${table_schema}"
        fi

        partition_name_template="$(yq '.partition.naming.template // strenv(GLOBAL_PARTITION_NAME_TEMPLATE)' <<< "${table}")"
        if [[ "${partition_name_template}" == "null" ]]; then
            echo "ERROR: Partition name template is required" >&2
            echo "HINT: Please provide a name template for partitions in the config file either in the table level config or in the global config" >&2
            exit 1
        fi

        partition_interval="$(yq '.partition.interval // strenv(GLOBAL_INTERVAL)' <<< "${table}")"
        if [[ "${partition_interval}" == "null" ]]; then
            echo "ERROR: Partition interval is required" >&2
            echo "HINT: Please provide a partition interval in the config file either in the partition config or in the global config" >&2
            exit 1
        fi

        partition_start_timestamp="$(yq '.partition.start_timestamp // strenv(GLOBAL_START_TIMESTAMP)' <<< "${table}")"
        if [[ "${partition_start_timestamp}" == "null" ]]; then
            echo "ERROR: Partition start timestamp is required" >&2
            echo "HINT: Please provide a partition start timestamp in the config file either in the partition config or in the global config" >&2
            exit 1
        fi

        partition_tablespace="$(yq '.partition.tablespace // strenv(GLOBAL_PARTITION_TABLESPACE)' <<< "${table}")"
        index_tablespace="$(yq '.partition.index.tablespace // strenv(GLOBAL_INDEX_TABLESPACE)' <<< "${table}")"

        past_partitions="$(yq '.partition.past // strenv(GLOBAL_PAST)' <<< "${table}")"
        future_partitions="$(yq '.partition.future // strenv(GLOBAL_FUTURE)' <<< "${table}")"
        retention="$(yq '.partition.retention // strenv(GLOBAL_RETENTION)' <<< "${table}")"

        # Because yq default value operator is used to provide alternative (or default) values
        # when a particular expression is either null or false, we cannot use it here as it would
        # instead override partition level boolean values such as true, instead we override them if they are not set.
        skip_overlapping="$(yq '.partition.skip_overlapping' <<< "${table}")"
        if [[ "${skip_overlapping}" == "null" ]]; then
            skip_overlapping="${GLOBAL_SKIP_OVERLAPPING}"
        fi
        echo "DEBUG: skip_overlapping value for ${table_schema}.${table_name} is ${skip_overlapping}"

        idempotency="$(yq '.partition.idempotency' <<< "${table}")"
        if [[ "${idempotency}" == "null" ]]; then
            idempotency="${GLOBAL_IDEMPOTENT}"
        fi

        default_partition_name_template="$(yq '.partition.default.naming.template // strenv(GLOBAL_DEFAULT_PARTITION_NAME_TEMPLATE)' <<< "${table}")"

        partition_storage_parameters="$(yq '.partition.partition_storage_parameters // strenv(GLOBAL_PARTITION_STORAGE_PARAMETERS)' <<< "${table}")"
        index_storage_parameters="$(yq '.partition.index_storage_parameters // strenv(GLOBAL_INDEX_STORAGE_PARAMETERS)' <<< "${table}")"

        template_table="$(yq '.template_table' <<< "${table}")"

        output_filename="$(pgp-get-migration-filename -t "${output_file_template}" -d "${temp_migration_directory}" -m "${description}")"

        echo "INFO: Making partitions for ${table_schema}.${table_name}"

        if [[ "${partition_start_timestamp}" == "LATEST_PARTITION" ]]; then
            echo "INFO: Using latest partition for partition start timestamp"

            if ! partition_start_timestamp="$(
                PGUSER="${PGP_USER}" \
                PGPASSWORD="${PGP_PASSWORD}" \
                PGDATABASE="${PGP_DATABASE}" \
                PGHOST="${PGP_HOST}" \
                PGPORT="${PGP_PORT}" \
                psql \
                    --tuples-only \
                    --no-align \
                    --quiet \
                    --variable "ON_ERROR_STOP=1" \
                    --variable table_schema="${table_schema}" \
                    --variable table_name="${table_name}" \
                    <<EOF
SELECT upper_bound
  FROM pgpartium.get_latest_partition(
           p_table_schema => :'table_schema'
         , p_table_name   => :'table_name'
       );
EOF
            )"; then
                echo "ERROR: Failed to get latest partition for table ${table_schema}.${table_name}" >&2
                exit 1
            fi

            if [[ -z "${partition_start_timestamp}" ]]; then
                echo "ERROR: No latest partition exists for table ${table_schema}.${table_name}" >&2
                exit 1
            fi
            echo "INFO: Latest partition upper bound is ${partition_start_timestamp}"
        fi

        if [[ "${template_table}" == "DEFAULT_PARTITION" ]]; then
            echo "INFO: Using default partition as template table"

            if ! result="$(
                PGUSER="${PGP_USER}" \
                PGPASSWORD="${PGP_PASSWORD}" \
                PGDATABASE="${PGP_DATABASE}" \
                PGHOST="${PGP_HOST}" \
                PGPORT="${PGP_PORT}" \
                psql \
                    --tuples-only \
                    --no-align \
                    --quiet \
                    --csv \
                    --variable "ON_ERROR_STOP=1" \
                    --variable table_schema="${table_schema}" \
                    --variable table_name="${table_name}" \
                    <<EOF
SELECT partition_schema
     , partition_name
  FROM pgpartium.get_default_partition(
           p_table_schema => :'table_schema',
           p_table_name   => :'table_name'
       );
EOF
            )"; then
                echo "ERROR: Failed to get default partition for table ${table_schema}.${table_name}" >&2
                exit 1
            fi

            if [[ -z "${result}" ]]; then
                echo "ERROR: Default partition for table ${table_schema}.${table_name} not found" >&2
                exit 1
            fi

            IFS=',' read -r template_table_schema template_table_name <<< "${result}"

        elif [[ "${template_table}" == "LATEST_PARTITION" ]]; then
            echo "INFO: Using latest partition as template table"

            if ! result="$(
                PGUSER="${PGP_USER}" \
                PGPASSWORD="${PGP_PASSWORD}" \
                PGDATABASE="${PGP_DATABASE}" \
                PGHOST="${PGP_HOST}" \
                PGPORT="${PGP_PORT}" \
                psql \
                    --tuples-only \
                    --no-align \
                    --quiet \
                    --csv \
                    --variable "ON_ERROR_STOP=1" \
                    --variable table_schema="${table_schema}" \
                    --variable table_name="${table_name}" \
                    <<EOF
SELECT partition_schema
     , partition_name
  FROM pgpartium.get_latest_partition(
           p_table_schema => :'table_schema',
           p_table_name   => :'table_name'
       );
EOF
            )"; then
                echo "ERROR: Failed to get latest partition for table ${table_schema}.${table_name}" >&2
                exit 1
            fi

            if [[ -z "${result}" ]]; then
                echo "ERROR: Latest partition for table ${table_schema}.${table_name} not found" >&2
                exit 1
            fi

            IFS=',' read -r template_table_schema template_table_name <<< "${result}"

        elif [[ "${template_table}" == "CURRENT_PARTITION" ]]; then
            echo "INFO: Using current partition as template table"

            if ! result="$(
                PGUSER="${PGP_USER}" \
                PGPASSWORD="${PGP_PASSWORD}" \
                PGDATABASE="${PGP_DATABASE}" \
                PGHOST="${PGP_HOST}" \
                PGPORT="${PGP_PORT}" \
                psql \
                    --tuples-only \
                    --no-align \
                    --quiet \
                    --csv \
                    --variable "ON_ERROR_STOP=1" \
                    --variable table_schema="${table_schema}" \
                    --variable table_name="${table_name}" \
                    <<EOF
SELECT partition_schema
     , partition_name
  FROM pgpartium.get_current_partition(
           p_table_schema => :'table_schema',
           p_table_name   => :'table_name'
       );
EOF
            )"; then
                echo "ERROR: Failed to get current partition for table ${table_schema}.${table_name}" >&2
                exit 1
            fi

            if [[ -z "${result}" ]]; then
                echo "ERROR: Current partition for table ${table_schema}.${table_name} not found" >&2
                exit 1
            fi

            IFS=',' read -r template_table_schema template_table_name <<< "${result}"

        else
            template_table_schema="$(yq '.schema' <<< "${template_table}")"
            template_table_name="$(yq '.name' <<< "${template_table}")"

            template_table_exists="$(
            PGUSER="${PGP_USER}" \
            PGPASSWORD="${PGP_PASSWORD}" \
            PGDATABASE="${PGP_DATABASE}" \
            PGHOST="${PGP_HOST}" \
            PGPORT="${PGP_PORT}" \
            psql \
                --tuples-only \
                --no-align \
                --quiet \
                -v "ON_ERROR_STOP=1" \
                -v table_schema="${template_table_schema}" \
                -v table_name="${template_table_name}" \
                <<EOF
SELECT pgpartium.table_exists(p_table_schema => :'table_schema', p_table_name => :'table_name');
EOF
)"

            if [[ "${template_table_exists}" = "false" ]]; then
                echo "ERROR: Template table ${template_table_schema}.${template_table_name} does not exist" >&2
                exit 1
            fi

        fi

        error_file="${temp_error_directory}/${table_schema}.${table_name}.error"

        if ! PGUSER="${PGP_USER}" PGPASSWORD="${PGP_PASSWORD}" \
             PGDATABASE="${PGP_DATABASE}" PGHOST="${PGP_HOST}" PGPORT="${PGP_PORT}" \
             psql \
                 --tuples-only \
                 --no-align \
                 --quiet \
                 --variable "ON_ERROR_STOP=1" \
                 --variable table_schema="${table_schema}" \
                 --variable table_name="${table_name}" \
                 --variable partition_name_template="${partition_name_template}" \
                 --variable partition_interval="${partition_interval}" \
                 --variable partition_start_timestamp="${partition_start_timestamp}" \
                 --variable past_partitions="${past_partitions}" \
                 --variable future_partitions="${future_partitions}" \
                 --variable default_partition_name_template="${default_partition_name_template}" \
                 --variable partition_schema="${partition_schema}" \
                 --variable partition_tablespace="${partition_tablespace}" \
                 --variable index_tablespace="${index_tablespace}" \
                 --variable partition_storage_parameters="${partition_storage_parameters}" \
                 --variable index_storage_parameters="${index_storage_parameters}" \
                 --variable template_table_schema="${template_table_schema}" \
                 --variable template_table_name="${template_table_name}" \
                 --variable retention="${retention}" \
                 --variable timezone="${timezone}" \
                 --variable skip_overlapping="${skip_overlapping}" \
                 --variable idempotency="${idempotency}" \
                 --output="${temp_migration_directory}/${output_filename}" \
            2>"${error_file}" \
            <<EOF
SELECT *
  FROM pgpartium.make_partitions(
    p_table_schema=>:'table_schema'
  , p_table_name=>:'table_name'
  , p_partition_name_template=>:'partition_name_template'
  , p_interval=>:'partition_interval'
  , p_start_timestamp=>:'partition_start_timestamp'
  , p_past=>:'past_partitions'
  , p_future=>:'future_partitions'
  , p_default_partition_name_template=>NULLIF(:'default_partition_name_template', 'null')
  , p_partition_schema=>:'partition_schema'
  , p_partition_tablespace=>NULLIF(:'partition_tablespace', 'null')
  , p_index_tablespace=>NULLIF(:'index_tablespace', 'null')
  , p_partition_storage_parameters=>NULLIF(:'partition_storage_parameters', 'null')::jsonb
  , p_index_storage_parameters=>NULLIF(:'index_storage_parameters', 'null')::jsonb
  , p_template_table_schema=>NULLIF(:'template_table_schema', 'null')
  , p_template_table_name=>NULLIF(:'template_table_name', 'null')
  , p_retention=>NULLIF(:'retention', 'null')::interval
  , p_timezone=>:'timezone'
  , p_skip_overlapping=>:'skip_overlapping'
  , p_idempotency=>:'idempotency'
)
EOF

        then
            failed_tables["${table_schema}.${table_name}"]=$(<"${error_file}")
            continue
        fi

        if [[ -s "${temp_migration_directory}/${output_filename}" ]]; then
            # PSQL adds an empty line at the end, so remove it
            sed -i -e '${/^$/d;}' "${temp_migration_directory}/${output_filename}"
            echo "INFO: Made partitions for ${table_schema}.${table_name}"
            printf "\nMakes partitions for \`%s\`\n\n" "${table_schema}.${table_name}" >> /src/partition_maintenance.log
        else
            echo "INFO: No partitions made for ${table_schema}.${table_name}"
            rm "${temp_migration_directory}/${output_filename}"
        fi

    done < <(yq '.lifecycle.tables[] | @json' "${config}")

    if [ "${#failed_tables[@]}" -gt 0 ]; then
        echo "ERROR: failed for ${#failed_tables[@]} table(s):" >&2
        for table in "${!failed_tables[@]}"; do
            echo "  '${table}': ${failed_tables[${table}]}" >&2
        done
        exit 1
    else
        cp -rf "${temp_migration_directory}/." "${directory}/"
    fi

}

function run_make_partitions {
    if [[ -d "${config_path}" ]]; then
        echo "INFO: Applying configs from ${config_path}"

        find "${config_path}" -type f \( -iname "*.yaml" -o -iname "*.yml" \) \
        | sort \
        | while IFS= read -r config; do
            make_partitions "${config}"
        done

        echo "INFO: Applied configs from ""${config_path}"""
    else
        make_partitions "${config_path}"
        echo "INFO: Applied config ""${config_path}"""
    fi
}

run_make_partitions "${config_path}"
