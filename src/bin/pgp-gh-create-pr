#!/bin/bash

usage() {
    cat <<EOF
    ${0##*/}

    Creates or updates a pull request on github.

    OPTIONS:
      -C  the repository directory to operate in (Default: .)
      -b  the branch name to use (Default: partition-lifecycle)
      -t  the title of the pull request (Default: chore: partition lifecycle)
      -m  the commit message (Default: chore: partition lifecycle)
      -n  the git committer name (Default: the already-configured git identity)
      -e  the git committer email (Default: the already-configured git identity)
      -h  show this help message.

    SAMPLE USAGE:
        ${0##*/} -b specific-branch -t "custom title" -m "custom commit"
EOF
}

target_dir="."

while getopts "C:b:t:m:n:e:h" option; do
    case "${option}" in
        C)
            target_dir="${OPTARG}"
            ;;
        b)
            branch="${OPTARG}"
            ;;
        t)
            title="${OPTARG}"
            ;;
        m)
            commit_msg="${OPTARG}"
            ;;
        n)
            committer_name="${OPTARG}"
            ;;
        e)
            committer_email="${OPTARG}"
            ;;
        h)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
done

set -euo pipefail

cd "${target_dir}"

if git diff --quiet -- && [ -z "$(git ls-files --others --exclude-standard)" ]; then
    echo "INFO: No changes detected. Exiting..."
    exit 0
fi

branch=${branch:-"partition-lifecycle"}
title=${title:-"chore: partition lifecycle"}
commit_msg=${commit_msg:-"${title}"}

full_branch="pgpartix/${branch}"
base_branch="$(git remote show origin | awk '/HEAD branch/ {print $NF}')"

# Only override the Git identity when explicitly requested, such as when using
# a GitHub App in CI. Otherwise, use the identity already configured by the
# calling environment. Apply overrides at repository scope to avoid modifying
# global Git configuration, especially on persistent self-hosted runners.
if [[ -n "${committer_email:-}" ]]; then
    git config user.email "${committer_email}"
fi

if [[ -n "${committer_name:-}" ]]; then
    git config user.name "${committer_name}"
fi

if ! git config --get user.name >/dev/null ||
   ! git config --get user.email >/dev/null; then
    echo "ERROR: Git committer identity is not configured." >&2
    echo "Provide -n and -e, or configure git user.name and user.email." >&2
    exit 1
fi

# Create or reset our branch
git checkout -B "${full_branch}"

git add -A
git commit -m "${commit_msg}"

# Push to remote
git push origin "${full_branch}" --force

# Generate body of PR
log=$(cat /src/partition_lifecycle.log)
body=$(cat <<EOF
## Summary

This pull request was automatically generated by **pgpartix** to apply partition lifecycle changes.

### Changes

${log}
EOF
)

# Create PR
PR_URL="$(gh pr list \
    --head "${full_branch}" \
    --state open \
    --json url \
    --jq '.[0].url')"

if [[ -n "${PR_URL}" ]]; then
    echo "INFO: PR already exists: ${PR_URL}"
    echo "INFO: Editing the body of ${PR_URL}"
    gh pr edit "${PR_URL}" --body "${body}"
    PR_NUMBER="${PR_URL##*/}"
    echo "INFO: PR updated: ${PR_URL}"
else
    echo "INFO: Creating PR..."
    PR_URL="$(gh pr create \
        --base "${base_branch}" \
        --head "${full_branch}" \
        --title "${title}" \
        --body "${body}")"

    PR_NUMBER="${PR_URL##*/}"
    echo "INFO: PR #${PR_NUMBER} created: ${PR_URL}"
fi
