{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "pgpartium configuration schema",
    "description": "Schema for partition lifecycle.",
    "type": "object",
    "definitions": {
        "trimmed_non_blank_string": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$"
        },
        "name": {
            "description": "Name of a thing.",
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
        },
        "nullable_name": {
            "type": [
                "string",
                "null"
            ],
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$",
            "default": null
        },
        "name_template": {
            "$ref": "#/definitions/name",
            "description": "Template for naming objects."
        },
        "description": {
            "description": "A description of the partition lifecycle, available for use as {description} in output_file_template.",
            "type": "object",
            "properties": {
                "make": {
                    "$ref": "#/definitions/trimmed_non_blank_string",
                    "description": "A description for making of partitions.",
                    "default": "Make partitions for {table_schema}_{table_name}"
                },
                "expire": {
                    "$ref": "#/definitions/trimmed_non_blank_string",
                    "description": "A description for expiration of partitions.",
                    "default": "Expire partitions for {table_schema}_{table_name}"
                }
            },
            "minProperties": 1,
            "additionalProperties": false
        },
        "output_file_template": {
            "$ref": "#/definitions/name",
            "description": "Template for generating the output file name.",
            "examples": [
                "V{integer}__{description}.sql",
                "V{integer:3}__{description}.sql",
                "{timestamp}__{description}.sql",
                "{epoch}_{description}.up.sql"
            ],
            "default": "pgpartium_output.sql"
        },
        "timezone": {
            "$ref": "#/definitions/name",
            "description": "IANA timezone identifier defining the logical time context for all time-based operations (generation, expiry), independent of the execution environment (e.g. Europe/Berlin, UTC).",
            "default": "Etc/UTC"
        },
        "storage_parameters": {
            "description": "Storage parameters for relations (tables and indexes).",
            "type": [
                "object",
                "null"
            ],
            "default": null,
            "examples": [
                {
                    "fillfactor": 90,
                    "autovacuum_enabled": false
                },
                {
                    "fillfactor": 80,
                    "toast.fillfactor": 90
                }
            ],
            "minProperties": 1
        },
        "directory": {
            "$ref": "#/definitions/name",
            "description": "Directory where generated files are written.",
            "default": "."
        },
        "idempotency": {
            "description": "Whether to generate idempotent SQL.",
            "type": "boolean",
            "default": false
        },
        "naming": {
            "description": "Naming configuration.",
            "type": "object",
            "properties": {
                "template": {
                    "$ref": "#/definitions/name_template",
                    "description": "Template for naming objects.",
                    "examples": [
                        "{parent_schema}__{parent_name}__{partition_name}"
                    ]
                }
            },
            "minProperties": 1,
            "additionalProperties": false
        },
        "required_naming": {
            "description": "Naming configuration.",
            "type": "object",
            "properties": {
                "template": {
                    "$ref": "#/definitions/name_template",
                    "description": "Template for naming objects.",
                    "examples": [
                        "{parent_schema}__{parent_name}__{partition_name}"
                    ]
                }
            },
            "minProperties": 1,
            "additionalProperties": false,
            "required": [
                "template"
            ]
        },
        "extendable_naming": {
            "$ref": "#/definitions/naming",
            "description": "Extendable Naming configuration.",
            "additionalProperties": true
        },
        "partition": {
            "type": "object",
            "description": "Partition configuration.",
            "properties": {
                "naming": {
                    "$ref": "#/definitions/required_naming",
                    "description": "Partition naming configuration.",
                    "properties": {
                        "template": {
                            "examples": [
                                "{parent_schema}__{parent_name}__YYYY_MM",
                                "{parent_schema}__{parent_name}__YYYY_MM_DD"
                            ]
                        }
                    }
                },
                "schema": {
                    "$ref": "#/definitions/name",
                    "description": "Schema name.",
                    "default": "parent's schema"
                },
                "tablespace": {
                    "$ref": "#/definitions/nullable_name",
                    "description": "Tablespace name."
                },
                "storage_parameters": {
                    "$ref": "#/definitions/storage_parameters",
                    "description": "Storage parameters for partitions."
                },
                "interval": {
                    "$ref": "#/definitions/trimmed_non_blank_string",
                    "description": "The partition interval.",
                    "example": [
                        "(n) hours",
                        "(n) days",
                        "(n) weeks",
                        "(n) months",
                        "(n) years"
                    ]
                },
                "start_timestamp": {
                    "description": "The start timestamp for partition generation. Can also be LATEST_PARTITION to use the most recent partition.",
                    "oneOf": [
                        {
                            "type": "string",
                            "description": "A timestamp in RFC 3339 format (YYYY-MM-DDTHH:MM:SS.ffffff+HH:MM)",
                            "format": "date-time"
                        },
                        {
                            "type": "string",
                            "enum": [
                                "LATEST_PARTITION",
                                "NOW",
                                "TODAY"
                            ]
                        }
                    ],
                    "examples": [
                        "2024-01-01T00:00:00Z",
                        "LATEST_PARTITION"
                    ],
                    "default": "NOW"
                },
                "past": {
                    "description": "The number of past partitions to make.",
                    "type": "integer",
                    "minimum": 0,
                    "default": 0
                },
                "future": {
                    "description": "The number of future partitions to make.",
                    "type": "integer",
                    "minimum": 0,
                    "default": 0
                },
                "default": {
                    "type": "object",
                    "description": "Default partition configuration.",
                    "properties": {
                        "naming": {
                            "$ref": "#/definitions/required_naming",
                            "description": "Default partition naming configuration.",
                            "properties": {
                                "template": {
                                    "description": "Template for naming default partition.",
                                    "examples": [
                                        "{parent_schema}__{parent_name}__default"
                                    ]
                                }
                            }
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "naming"
                    ]
                },
                "skip_overlapping": {
                    "description": "Whether to skip overlapping partitions. Useful when switching partition intervals. It allows resolving such overlaps manually",
                    "type": "boolean",
                    "default": false
                },
                "constraint": {
                    "type": "object",
                    "description": "Constraint configuration.",
                    "properties": {
                        "naming": {
                            "type": "object",
                            "description": "Naming configuration for constraints.",
                            "properties": {
                                "template": {
                                    "$ref": "#/definitions/name_template",
                                    "description": "Template for naming constraints.",
                                    "examples": [
                                        "{parent_schema}__{parent_name}__default"
                                    ],
                                    "default": "{partition_name}_{constraint_keys}_{constraint_suffix}"
                                },
                                "primary_key": {
                                    "$ref": "#/definitions/naming",
                                    "description": "Naming configuration for primary keys.",
                                    "properties": {
                                        "template": {
                                            "description": "Template for naming primary keys.",
                                            "examples": [
                                                "{partition_name}_pkey"
                                            ],
                                            "default": "{partition_name}_pkey"
                                        }
                                    }
                                },
                                "foreign_key": {
                                    "$ref": "#/definitions/naming",
                                    "description": "Naming configuration for foreign keys.",
                                    "properties": {
                                        "template": {
                                            "description": "Template for naming foreign keys.",
                                            "examples": [
                                                "{partition_name}_{constraint_keys}_fkey"
                                            ],
                                            "default": "{partition_name}_{constraint_keys}_fkey"
                                        }
                                    }
                                },
                                "unique": {
                                    "$ref": "#/definitions/naming",
                                    "description": "Naming configuration for unique constraints.",
                                    "properties": {
                                        "template": {
                                            "description": "Template for naming unique constraints.",
                                            "examples": [
                                                "{partition_name}_{constraint_keys}_key"
                                            ],
                                            "default": "{partition_name}_{constraint_keys}_key"
                                        }
                                    }
                                },
                                "check": {
                                    "$ref": "#/definitions/naming",
                                    "description": "Naming configuration for check constraints.",
                                    "properties": {
                                        "template": {
                                            "description": "Template for naming check constraints.",
                                            "examples": [
                                                "{partition_name}_{constraint_keys}_check"
                                            ],
                                            "default": "{partition_name}_{constraint_keys}_check"
                                        }
                                    }
                                },
                                "exclusion": {
                                    "$ref": "#/definitions/naming",
                                    "description": "Naming configuration for exclusion constraints.",
                                    "properties": {
                                        "template": {
                                            "description": "Template for naming exclusion constraints.",
                                            "examples": [
                                                "{partition_name}_excl"
                                            ],
                                            "default": "{partition_name}_{constraint_keys}_excl"
                                        }
                                    },
                                    "additionalProperties": false
                                },
                                "constraint_trigger": {
                                    "$ref": "#/definitions/naming",
                                    "description": "Naming configuration for constraint triggers.",
                                    "properties": {
                                        "template": {
                                            "description": "Template for naming constraint triggers.",
                                            "examples": [
                                                "{partition_name}_{constraint_keys}_trig"
                                            ],
                                            "default": "{partition_name}_{constraint_keys}_trig"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "minProperties": 1,
                    "additionalProperties": false
                },
                "index": {
                    "type": "object",
                    "description": "Index configuration.",
                    "properties": {
                        "naming": {
                            "$ref": "#/definitions/naming",
                            "description": "Index naming configuration.",
                            "properties": {
                                "template": {
                                    "description": "Template for naming indexes.",
                                    "examples": [
                                        "{partition_name}_{index_keys}_idx",
                                        "{partition_name}_{index_keys}_idx{ordinal}"
                                    ],
                                    "default": "{partition_name}_{index_keys}_idx{ordinal}"
                                }
                            }
                        },
                        "tablespace": {
                            "$ref": "#/definitions/nullable_name",
                            "description": "Tablespace for indexes."
                        },
                        "storage_parameters": {
                            "$ref": "#/definitions/storage_parameters",
                            "description": "Storage parameters for indexes.",
                            "examples": [
                                {
                                    "fillfactor": true,
                                    "deduplicate_items": true
                                }
                            ]
                        }
                    },
                    "minProperties": 1,
                    "additionalProperties": false
                },
                "trigger": {
                    "type": "object",
                    "description": "Trigger configuration.",
                    "properties": {
                        "naming": {
                            "$ref": "#/definitions/naming",
                            "description": "Trigger naming configuration.",
                            "properties": {
                                "template": {
                                    "$ref": "#/definitions/name_template",
                                    "description": "Template for naming triggers.",
                                    "examples": [
                                        "{partition_name}_{timing}_{events}_{function_name}"
                                    ],
                                    "default": "{partition_name}_{timing}_{events}_{function_name}"
                                }
                            }
                        }
                    }
                },
                "retention": {
                    "$ref": "#/definitions/nullable_name",
                    "description": "The retention time interval to expire partitions older than the given interval."
                },
                "detach_first": {
                    "description": "Whether to detach the expired partitions first before dropping them.",
                    "type": "boolean",
                    "default": false
                },
                "detach_only": {
                    "description": "Whether to only detach the expired partitions.",
                    "type": "boolean",
                    "default": false
                },
                "detach_concurrently": {
                    "description": "Whether to detach the expired partitions concurrently.",
                    "type": "boolean",
                    "default": false
                }
            },
            "minProperties": 1,
            "additionalProperties": false
        }
    },
    "properties": {
        "lifecycle": {
            "description": "The partition lifecycle configuration.",
            "type": "object",
            "properties": {
                "directory": {
                    "$ref": "#/definitions/directory"
                },
                "description": {
                    "$ref": "#/definitions/description"
                },
                "timezone": {
                    "$ref": "#/definitions/timezone"
                },
                "output_file_template": {
                    "$ref": "#/definitions/output_file_template"
                },
                "partition": {
                    "$ref": "#/definitions/partition"
                },
                "tables": {
                    "description": "List of tables to run partition lifecycle for.",
                    "type": "array",
                    "items": {
                        "description": "The table to run partition lifecycle for.",
                        "type": "object",
                        "properties": {
                            "schema": {
                                "$ref": "#/definitions/name",
                                "description": "The schema of the table."
                            },
                            "name": {
                                "$ref": "#/definitions/name",
                                "description": "The name of the table."
                            },
                            "description": {
                                "$ref": "#/definitions/description"
                            },
                            "output_file_template": {
                                "$ref": "#/definitions/output_file_template"
                            },
                            "partition": {
                                "$ref": "#/definitions/partition",
                                "description": "The partition configuration for the table."
                            },
                            "template_table": {
                                "description": "The template table to replicate objects such as constraints, indexes, triggers from.",
                                "type": [
                                    "object",
                                    "string"
                                ],
                                "oneOf": [
                                    {
                                        "description": "Must be one of the predefined options.",
                                        "type": "string",
                                        "enum": [
                                            "DEFAULT_PARTITION",
                                            "LATEST_PARTITION",
                                            "CURRENT_PARTITION"
                                        ]
                                    },
                                    {
                                        "type": "object",
                                        "properties": {
                                            "schema": {
                                                "$ref": "#/definitions/name"
                                            },
                                            "name": {
                                                "$ref": "#/definitions/name"
                                            }
                                        },
                                        "required": [
                                            "schema",
                                            "name"
                                        ],
                                        "additionalProperties": false
                                    }
                                ]
                            }
                        },
                        "required": [
                            "schema",
                            "name"
                        ],
                        "additionalProperties": false
                    },
                    "minItems": 1
                }
            },
            "required": [
                "tables"
            ],
            "additionalProperties": false
        }
    },

    "required": [
        "lifecycle"
    ],
    "additionalProperties": false
}
