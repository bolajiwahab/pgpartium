{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "pgpartium configuration schema",
    "description": "Schema for partition lifecycle.",
    "type": "object",
    "definitions": {
        "description": {
            "description": "A description of the partition lifecycle, available for use as {description} in output_file_template.",
            "type": "object",
            "properties": {
                "make": {
                    "description": "A description for making of partitions.",
                    "type": "string",
                    "minLength": 1
                },
                "expire": {
                    "description": "A description for expiration of partitions.",
                    "type": "string",
                    "minLength": 1
                }
            },
            "minProperties": 1,
            "additionalProperties": false
        },
        "output_file_template": {
            "description": "Template for generating the output file name.",
            "type": "string",
            "examples": [
                "V{integer}__{description}.sql",
                "V{integer:3}__{description}.sql",
                "{timestamp}__{description}.sql",
                "{epoch}_{description}.up.sql"
            ],
            "minLength": 1
        },
        "timezone": {
            "description": "IANA timezone identifier defining the logical time context for all time-based operations (generation, expiry), independent of the execution environment (e.g. Europe/Berlin, UTC).",
            "type": "string",
            "default": "Etc/UTC"
        },
        "storage_parameters": {
            "description": "Storage parameters for relations (tables and indexes).",
            "type": "object",
            "examples": [
                {
                    "fillfactor": 90,
                    "autovacuum_enabled": "false"
                },
                {
                    "fillfactor": 80,
                    "toast.fillfactor": 90
                }
            ],
            "minProperties": 1
        },
        "trimmed_non_blank_string": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$"
        },
        "name": {
            "$ref": "#/definitions/trimmed_non_blank_string",
            "description": "Name of a something."
        },
        "directory": {
            "$ref": "#/definitions/name",
            "description": "The directory to generate output files in."
        },
        "schema": {
            "$ref": "#/definitions/name",
            "description": "Schema name."
        },

        "partition": {
            "type": "object",
            "description": "Partition configuration.",
            "properties": {
                "schema": {
                    "$ref": "#/definitions/schema"
                },
                "tablespace": {
                    "$ref": "#/definitions/tablespace"
                },
                "index_tablespace": {
                    "$ref": "#/definitions/tablespace"
                },
                "storage_parameters": {
                    "$ref": "#/definitions/storage_parameters",
                    "description": "Storage parameters for the partitions."
                },
                "index_storage_parameters": {
                    "$ref": "#/definitions/storage_parameters"
                },
                "name_template": {
                    "$ref": "#/definitions/name"
                },
                "interval": {
                    "$ref": "#/definitions/interval"
                },
                "past": {
                    "$ref": "#/definitions/past"
                },
                "future": {
                    "$ref": "#/definitions/future"
                },
                "create_default": {
                    "$ref": "#/definitions/create_default"
                },
                "default_partition_name_template": {
                    "$ref": "#/definitions/name"
                },
                "retention": {
                    "$ref": "#/definitions/retention"
                },
                "detach_first": {
                    "$ref": "#/definitions/detach_first"
                },
                "detach_only": {
                    "$ref": "#/definitions/detach_only"
                },
                "detach_concurrently": {
                    "$ref": "#/definitions/detach_concurrently"
                },
                "skip_overlapping": {
                    "$ref": "#/definitions/skip_overlapping"
                },
                "idempotent_ddl": {
                    "$ref": "#/definitions/idempotent_ddl"
                }
            },
            "additionalProperties": false
        },

        "tablespace": {
            "$ref": "#/definitions/name",
            "description": "Tablespace name."
        },
        "index_tablespace": {
            "$ref": "#/definitions/tablespace",
            "description": "The tablespace for the indexes.",
            "default": "partition's tablespace"
        },
        "name_template": {
            "$ref": "#/definitions/name",
            "description": "The name template for the partitions.",
            "examples": [
                "{table_schema}__{table_name}__YYYY_MM_DD",
                "{table_schema}__{table_name}__YYYY_MM"
            ]
        },
        "default_partition_name_template": {
            "$ref": "#/definitions/name",
            "description": "The name template for the default partition.",
            "examples": [
                "{table_schema}__{table_name}__default"
            ]
        },
        "interval": {
            "description": "The partition interval.",
            "type": "string",
            "minLength": 1
        },
        "past": {
            "description": "The number of past partitions to make.",
            "type": "integer",
            "minimum": 0,
            "default": 0
        },
        "future": {
            "description": "The number of future partitions to make.",
            "type": "integer",
            "minimum": 0,
            "default": 0
        },
        "create_default": {
            "description": "Whether to create default partition.",
            "type": "boolean",
            "default": false
        },
        "retention": {
            "description": "The retention time interval to expire partitions containing data older than the given interval.",
            "type": [
                "string",
                "null"
            ],
            "minLength": 1,
            "default": "null"
        },
        "detach_first": {
            "description": "Whether to detach the expired partitions first before dropping them.",
            "type": "boolean",
            "default": false
        },
        "detach_only": {
            "description": "Whether to only detach the expired partitions.",
            "type": "boolean",
            "default": false
        },
        "detach_concurrently": {
            "description": "Whether to detach the expired partitions concurrently.",
            "type": "boolean",
            "default": false
        },
        "skip_overlapping": {
            "description": "Whether to skip overlapping partitions. Useful when switching partition intervals. It allows resolving such overlaps manually",
            "type": "boolean",
            "default": false
        },
        "idempotent_ddl": {
            "description": "Whether to generate idempotent DDL.",
            "type": "boolean",
            "default": false
        }
    },
    "properties": {
        "lifecycle": {
            "description": "The partition lifecycle configuration.",
            "type": "object",
            "properties": {
                "directory": {
                    "$ref": "#/definitions/directory"
                },

                "partition": {
                    "$ref": "#/definitions/partition",
                    "description": "The partition configuration."
                },

                "tables": {
                    "description": "List of tables to run partition lifecycle for.",
                    "type": "array",
                    "items": {
                        "description": "The table to run partition lifecycle for.",
                        "type": "object",
                        "properties": {
                            "schema": {
                                "$ref": "#/definitions/schema",
                                "description": "The schema of the table."
                            },
                            "name": {
                                "$ref": "#/definitions/name",
                                "description": "The name of the table."
                            },
                            "description": {
                                "$ref": "#/definitions/description"
                            },
                            "output_file_template": {
                                "$ref": "#/definitions/output_file_template"
                            },
                            "partition": {
                                "$ref": "#/definitions/partition",
                                "description": "The partition configuration for the table."
                            },
                            "template_table": {
                                "description": "The template table to replicate objects such as constraints, indexes, triggers from.",
                                "type": [
                                    "object",
                                    "string"
                                ],
                                "oneOf": [
                                    {
                                        "description": "Must be one of the predefined options.",
                                        "type": "string",
                                        "enum": [
                                            "DEFAULT_PARTITION",
                                            "LATEST_PARTITION",
                                            "CURRENT_PARTITION"
                                        ]
                                    },
                                    {
                                        "type": "object",
                                        "properties": {
                                            "table_schema": {
                                                "$ref": "#/definitions/table_schema"
                                            },
                                            "table_name": {
                                                "$ref": "#/definitions/table_name"
                                            }
                                        },
                                        "required": [
                                            "table_schema",
                                            "table_name"
                                        ],
                                        "additionalProperties": false
                                    }
                                ]
                            }
                        },
                        "required": [
                            "schema",
                            "name"
                        ],
                        "additionalProperties": false
                    },
                    "minItems": 1
                }
            },
            "required": [
                "directory",
                "tables"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "lifecycle"
    ],
    "additionalProperties": false
}
