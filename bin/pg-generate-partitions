#!/bin/bash

usage()
{
cat <<-EOF
    ${0##*/}
    
    Generates partitions for partitioned tables.

    OPTIONS:
    -c  the config file in yaml (Required)
    -h  show this help message.

    SAMPLE USAGE:
        ${0##*/} -c config.yaml
EOF
}

while getopts "c:h" OPTION
do
    case $OPTION in
        c)
            CONFIG="$OPTARG"
            ;;
        h | *)
            usage
            exit 0
            ;;
    esac
done

set -eu -o pipefail

CONFIG=${CONFIG:-}

# Ensure config is provided
if [[ -z "$CONFIG" ]]; then
  usage
  exit 1
fi

# Setup infrastructure
ls sql/*.sql | sort | xargs -I {} psql --quiet --username=postgres --dbname=postgres -f "{}"

# Validate schema
yq -o=json '.' "$CONFIG" | jsonschema schema.json

# Set defaults
export DEFAULT_TABLESPACE="pg_default"
export DEFAULT_SCHEMA="public"
export DEFAULT_PAST=0
export DEFAULT_FUTURE=0
export DEFAULT_INTERVAL="0"
export DEFAULT_PREFIX=""
export DEFAULT_SUFFIX=""
export DEFAULT_RETENTION_INTERVAL="0"
export DEFAULT_CREATE_DEFAULT=false

# Extract global configs
export GLOBAL_TABLESPACE=$(yq '.generates[].tablespace // strenv(DEFAULT_TABLESPACE)' "$CONFIG")
export GLOBAL_SCHEMA=$(yq '.generates[].schema // strenv(DEFAULT_SCHEMA)' "$CONFIG")
export GLOBAL_PAST=$(yq '.generates[].past // strenv(DEFAULT_PAST)' "$CONFIG")
export GLOBAL_FUTURE=$(yq '.generates[].future // strenv(DEFAULT_FUTURE)' "$CONFIG")
export GLOBAL_INTERVAL=$(yq '.generates[].interval // strenv(DEFAULT_INTERVAL)' "$CONFIG")
export GLOBAL_PREFIX=$(yq '.generates[].prefix // strenv(DEFAULT_PREFIX)' "$CONFIG")
export GLOBAL_SUFFIX=$(yq '.generates[].suffix // strenv(DEFAULT_SUFFIX)' "$CONFIG")
export GLOBAL_RETENTION_INTERVAL=$(yq '.generates[].retention_interval // strenv(DEFAULT_RETENTION_INTERVAL)' "$CONFIG")
export GLOBAL_CREATE_DEFAULT=$(yq '.generates[].create_default // strenv(DEFAULT_CREATE_DEFAULT)' "$CONFIG")

# Process  partitioned tableeach
yq '.generates[].tables[] | @json' "$CONFIG" | while read -r table; do
    TABLE_SCHEMA=$(echo "$table" | yq '.table_schema')
    TABLE_NAME=$(echo "$table" | yq '.table_name')
    PARTITION_SCHEMA=$(echo "$table" | yq '.partition.schema // strenv(GLOBAL_SCHEMA) // strenv(TABLE_SCHEMA)')
    PAST_PARTITIONS=$(echo "$table" | yq '.partition.past // strenv(GLOBAL_PAST)')
    FUTURE_PARTITIONS=$(echo "$table" | yq '.partition.future // strenv(GLOBAL_FUTURE)')
    PARTITION_INTERVAL=$(echo "$table" | yq '.partition.interval // strenv(GLOBAL_INTERVAL)')
    PARTITION_PREFIX=$(echo "$table" | yq '.partition.prefix // strenv(GLOBAL_PREFIX)')
    PARTITION_SUFFIX=$(echo "$table" | yq '.partition.suffix // strenv(GLOBAL_SUFFIX)')
    RETENTION_INTERVAL=$(echo "$table" | yq '.partition.retention_interval // strenv(GLOBAL_RETENTION_INTERVAL)')
    CREATE_DEFAULT_PARTITION=$(echo "$table" | yq '.partition.create_default // strenv(GLOBAL_CREATE_DEFAULT)')
    PARTITION_TABLESPACE=$(echo "$table" | yq '.partition.tablespace // strenv(GLOBAL_TABLESPACE)')
    # PARTITION=$(echo "$table" | yq '.partition.suffix')

    # Extract table-specific partition past value
    # TABLE_PAST=$(echo "$table" | yq '.partition.past')
    # yq '.a // .b' sample.yml
    # TABLE_PAST=$(echo "$table" | yq '.partition.past // strenv(GLOBAL_PAST)')

    # Use table-level past if set, otherwise fallback to global past (if set)
    # if [[ -n "$TABLE_PAST" ]]; then
    #     PAST=$TABLE_PAST
    # else
    #     PAST=$GLOBAL_PAST
    # fi

    echo "Table: $TABLE_SCHEMA.$TABLE_NAME"
    echo "Suffix: $PARTITION_SUFFIX"
    echo "GLlobal suffix: $DEFAULT_SUFFIX"
    echo "Global past: $CREATE_DEFAULT_PARTITION"
    # echo "  Partition: $PARTITION"

    psql --username=postgres \
         --dbname=postgres \
         --tuples-only \
         --no-align \
         --quiet \
         --output=${TABLE_NAME}.sql \
         <<EOF
SELECT *
  FROM pgpartium.generate_partitions('$TABLE_SCHEMA', '$TABLE_NAME', '$PARTITION_INTERVAL', $PAST_PARTITIONS, $FUTURE_PARTITIONS, '$PARTITION_PREFIX', '$PARTITION_SUFFIX', $GLOBAL_CREATE_DEFAULT, '$PARTITION_SCHEMA', '$PARTITION_TABLESPACE', '{}')
EOF
#  --command="SELECT * FROM pgpartium.generate_partitions('public', 'enrichment', '1 mon', 0, 1, 'public__', 'YYYY_MM', 'partitions', 'pg', '{}')"
    
    sed -i -z 's/\n$//' enrichment1.sql

done

# sudo psql -U postgres -d postgres -c "SELECT * from pgpartium.table_exists ('public', 'table')"
