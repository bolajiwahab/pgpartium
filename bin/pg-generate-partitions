#!/bin/bash

usage() {
    cat <<-EOF
    ${0##*/}

    Generates partitions for partitioned tables.

    OPTIONS:
    -c  the config file in yaml (Required)
    -h  show this help message.

    SAMPLE USAGE:
        ${0##*/} -c config.yaml
EOF
}

while getopts "c:h" option; do
    case "${option}" in
    c)
        config="${OPTARG}"
        ;;
    h | *)
        usage
        exit 0
        ;;
    esac
done

set -euo pipefail

config=${config:-}

# Ensure config is provided
if [[ -z "${config}" ]]; then
    usage
    exit 1
fi

# Setup infrastructure
echo "Setting up infra"
bin/pg-setup-infra

# Validate schema
yq -o=json '.' "${config}" | jsonschema schema.json

# Set defaults
export DEFAULT_TABLESPACE="pg_default"
export DEFAULT_PAST=0
export DEFAULT_FUTURE=0
export DEFAULT_RETENTION='-1'
export DEFAULT_CREATE_DEFAULT=false
export DEFAULT_SKIP_OVERLAPPING=false
export DEFAULT_STORAGE_PARAMETERS="{}"
export DEFAULT_TIMEZONE="UTC"

# Extract global configs
GLOBAL_SCHEMA=$(yq '.generates[].schema' "${config}")
GLOBAL_PARTITION_NAME_TEMPLATE=$(yq '.generates[].name_template' "${config}")
GLOBAL_PAST=$(yq '.generates[].past // strenv(DEFAULT_PAST)' "${config}")
GLOBAL_FUTURE=$(yq '.generates[].future // strenv(DEFAULT_FUTURE)' "${config}")
GLOBAL_INTERVAL=$(yq '.generates[].interval' "${config}")
GLOBAL_RETENTION=$(yq '.generates[].retention // strenv(DEFAULT_RETENTION)' "${config}")
GLOBAL_CREATE_DEFAULT=$(yq '.generates[].create_default // strenv(DEFAULT_CREATE_DEFAULT)' "${config}")
GLOBAL_DEFAULT_PARTITION_NAME_TEMPLATE=$(yq '.generates[].default_partition_name_template' "${config}")
GLOBAL_SKIP_OVERLAPPING=$(yq '.generates[].skip_overlapping // strenv(DEFAULT_SKIP_OVERLAPPING)' "${config}")
GLOBAL_PARTITION_TABLESPACE=$(yq '.generates[].tablespace // strenv(DEFAULT_TABLESPACE)' "${config}")
GLOBAL_STORAGE_PARAMETERS=$(yq '.generates[].storage_parameters // strenv(DEFAULT_STORAGE_PARAMETERS)' "${config}")
GLOBAL_TIMEZONE=$(yq '.generates[].timezone // strenv(DEFAULT_TIMEZONE)' "${config}")

export GLOBAL_PARTITION_TABLESPACE GLOBAL_SCHEMA GLOBAL_PARTITION_NAME_TEMPLATE GLOBAL_PAST GLOBAL_FUTURE GLOBAL_INTERVAL \
    GLOBAL_RETENTION GLOBAL_DEFAULT_PARTITION_NAME_TEMPLATE GLOBAL_SKIP_OVERLAPPING \
    GLOBAL_STORAGE_PARAMETERS GLOBAL_TIMEZONE

GLOBAL_INDEX_TABLESPACE=$(yq '.generates[].index_tablespace // strenv(GLOBAL_PARTITION_TABLESPACE)' "${config}")

export GLOBAL_INDEX_TABLESPACE

directory=$(yq '.generates[].directory' "${config}")

# Process each partitioned table
yq '.generates[].tables[] | @json' "${config}" | while read -r table; do
    table_schema=$(echo "${table}" | yq '.table_schema')
    table_name=$(echo "${table}" | yq '.table_name')
    partition_schema=$(echo "${table}" | yq '.partition.schema // strenv(GLOBAL_SCHEMA)')
    # If no schema is provided either in the partition config or in the global config, default to table schema
    if [[ "${partition_schema}" == "null" ]]; then
        partition_schema="${table_schema}"
    fi
    partition_name_template=$(echo "${table}" | yq '.partition.name_template // strenv(GLOBAL_PARTITION_NAME_TEMPLATE)')
    partition_tablespace=$(echo "${table}" | yq '.partition.tablespace // strenv(GLOBAL_PARTITION_TABLESPACE)')
    index_tablespace=$(echo "${table}" | yq '.partition.index_tablespace // strenv(GLOBAL_INDEX_TABLESPACE)')
    partition_interval=$(echo "${table}" | yq '.partition.interval // strenv(GLOBAL_INTERVAL)')
    past_partitions=$(echo "${table}" | yq '.partition.past // strenv(GLOBAL_PAST)')
    future_partitions=$(echo "${table}" | yq '.partition.future // strenv(GLOBAL_FUTURE)')
    retention=$(echo "${table}" | yq '.partition.retention // strenv(GLOBAL_RETENTION)')
    timezone=$(echo "${table}" | yq '.partition.timezone // strenv(GLOBAL_TIMEZONE)')
    # Because yq default value operator is used to provide alternative (or default) values
    # when a particular expression is either null or false, we cannot use it here since create_default is boolean
    # and we need to override it only when it is not set.
    create_default=$(echo "${table}" | yq '.partition.create_default')
    if [[ "${create_default}" == "null" ]]; then
        create_default="${GLOBAL_CREATE_DEFAULT}"
    fi
    # If create_default is true, default_partition_name_template is required
    default_partition_name_template=$(echo "${table}" | yq '.partition.default_partition_name_template // strenv(GLOBAL_DEFAULT_PARTITION_NAME_TEMPLATE)')
    if [[ "${create_default}" == true && "${default_partition_name_template}" == "null" ]]; then
        echo "DefaultPartitionNameTemplateError: Default partition name template is required when create_default is true."
        echo "Please provide a default partition name template in the config file."
        exit 1
    fi

    skip_overlapping=$(echo "${table}" | yq '.partition.skip_overlapping // strenv(GLOBAL_SKIP_OVERLAPPING)')
    storage_parameters=$(echo "${table}" | yq '.partition.storage_parameters // strenv(GLOBAL_STORAGE_PARAMETERS)')

    template_table=$(echo "${table}" | yq '.template')

    if [[ "${template_table}" == "DEFAULT_PARTITION" ]]; then
        IFS=',' read -r template_table_schema template_table_name < <(
            psql --username=postgres \
                --dbname=postgres \
                --tuples-only \
                --no-align \
                --quiet \
                --csv \
                -v "ON_ERROR_STOP=1" \
                -v table_schema="${table_schema}" \
                -v table_name="${table_name}" \
                <<EOF
SELECT partition_schema
     , partition_name
  FROM pgpartium.get_default_partition(p_table_schema=>:'table_schema', p_table_name=>:'table_name')
EOF
        ) || {
            echo "TemplateTableError: Default partition for table ${table_schema}.${table_name} not found."
            exit 1
        }

    elif [[ "${template_table}" == "LATEST_PARTITION" ]]; then
        IFS=',' read -r template_table_schema template_table_name < <(
            psql --username=postgres \
                --dbname=postgres \
                --tuples-only \
                --no-align \
                --quiet \
                --csv \
                -v "ON_ERROR_STOP=1" \
                -v table_schema="${table_schema}" \
                -v table_name="${table_name}" \
                <<EOF
SELECT partition_schema
     , partition_name
  FROM pgpartium.get_latest_partition(p_table_schema=>:'table_schema', p_table_name=>:'table_name')
EOF
        ) || {
            echo "TemplateTableError: Latest partition for table ${table_schema}.${table_name} not found."
            exit 1
        }

    elif [[ "${template_table}" == "CURRENT_PARTITION" ]]; then
        IFS=',' read -r template_table_schema template_table_name < <(
            psql --username=postgres \
                --dbname=postgres \
                --tuples-only \
                --no-align \
                --quiet \
                --csv \
                -v "ON_ERROR_STOP=1" \
                -v table_schema="${table_schema}" \
                -v table_name="${table_name}" \
                <<EOF
SELECT partition_schema
     , partition_name
  FROM pgpartium.get_current_partition(p_table_schema=>:'table_schema', p_table_name=>:'table_name')
EOF
        ) || {
            echo "TemplateTableError: Current partition for table ${table_schema}.${table_name} not found."
            exit 1
        }

    else
        template_table_schema=$(echo "${template_table}" | yq '.table_schema // ""')
        template_table_name=$(echo "${template_table}" | yq '.table_name // ""')

    fi

    output_filename="${table_name}_partitions.sql"

    psql --username=postgres \
        --dbname=postgres \
        --tuples-only \
        --no-align \
        --quiet \
        --echo-queries \
        -v "ON_ERROR_STOP=1" \
        -v table_schema="${table_schema}" \
        -v table_name="${table_name}" \
        -v partition_name_template="${partition_name_template}" \
        -v partition_interval="${partition_interval}" \
        -v past_partitions="${past_partitions}" \
        -v future_partitions="${future_partitions}" \
        -v create_default_partition="${create_default}" \
        -v default_partition_name_template="${default_partition_name_template}" \
        -v partition_schema="${partition_schema}" \
        -v partition_tablespace="${partition_tablespace}" \
        -v index_tablespace="${index_tablespace}" \
        -v storage_parameters="${storage_parameters}" \
        -v template_table_schema="${template_table_schema}" \
        -v template_table_name="${template_table_name}" \
        -v retention="${retention}" \
        -v timezone="${timezone}" \
        -v skip_overlapping="${skip_overlapping}" \
        --output="/tmp/${output_filename}" \
        <<EOF
SELECT *
  FROM pgpartium.generate_partitions(
    p_table_schema=>:'table_schema'
  , p_table_name=>:'table_name'
  , p_partition_name_template=>:'partition_name_template'
  , p_interval=>:'partition_interval'
  , p_past=>:'past_partitions'
  , p_future=>:'future_partitions'
  , p_create_default=>:'create_default_partition'
  , p_default_partition_name_template=>:'default_partition_name_template'
  , p_partition_schema=>:'partition_schema'
  , p_partition_tablespace=>:'partition_tablespace'
  , p_index_tablespace=>:'index_tablespace'
  , p_storage_parameters=>:'storage_parameters'
  , p_template_table_schema=>:'template_table_schema'
  , p_template_table_name=>:'template_table_name'
  , p_retention=>:'retention'
  , p_timezone=>:'timezone'
  , p_skip_overlapping=>:'skip_overlapping'
)
EOF
#     p_table_schema text
#   , p_table_name text
#   , p_partition_name_template text
#   , p_interval text
#   , p_past integer = 0
#   , p_future integer = 0
#   , p_create_default boolean = false
#   , p_default_partition_name_template text = NULL
#   , p_partition_schema text = NULL
#   , p_partition_tablespace text = 'pg_default'
#   , p_index_tablespace text = 'pg_default'
#   , p_storage_parameters jsonb = '{}'
#   , p_template_table_schema text = NULL
#   , p_template_table_name text = NULL
#   , p_retention interval = '-1'
#   , p_timezone text = 'UTC'
#   , p_skip_overlapping boolean = false
    # If file is not empty, move it to directory
    if [[ -s "/tmp/${output_filename}" ]]; then
        mv "/tmp/${output_filename}" "${directory}/${output_filename}"
        echo "Generated partitions for ${table_schema}.${table_name} in ${directory}/${output_filename}"
    else
        echo "No partitions generated for ${table_schema}.${table_name}"
    fi

done
