#!/bin/bash

usage() {
    echo "
    ${0##*/}

    Apply database migrations.

    OPTIONS:
      -m  the directory to the migration files (Required)
      -t  the migration tool (Required)
      -v  the migration tool version (Required)
      -u  the database username (Default: postgres)
      -w  the database password (Default: postgres)
      -s  the database host (Default: localhost)
      -p  the database port (Default: 5432)
      -d  the database name (Default: postgres)
      -h  show this help message.

    SAMPLE USAGE:
        ${0##*/} -m \"migrations\" -t flyway -v 11.8.0
        ${0##*/} -m \"migrations\" -t flyway -v 11.8.0 -u user -w password -s host -p port -d database
"
}

while getopts "m:t:v:u:w:s:p:d:h" option; do
    case "${option}" in
    m)
        directory="${OPTARG}"
        ;;
    t)
        tool="${OPTARG}"
        ;;
    v)
        version="${OPTARG}"
        ;;
    u)
        dbuser="${OPTARG}"
        ;;
    w)
        dbpassword="${OPTARG}"
        ;;
    s)
        dbhost="${OPTARG}"
        ;;
    p)
        dbport="${OPTARG}"
        ;;
    d)
        dbname="${OPTARG}"
        ;;
    h | *)
        usage
        exit 0
        ;;
    esac
done

set -euo pipefail

config=${config:-}
dbuser=${dbuser:-postgres}
dbpassword=${dbpassword:-postgres}
dbhost=${dbhost:-localhost}
dbport=${dbport:-5432}
dbname=${dbname:-postgres}

# Ensure required parameters are provided.
if [[ -z "${directory}" || -z "${tool}" || -z "${version}" ]]; then
    usage
    exit 1
fi

run_flyway() {
    base_url="https://repo1.maven.org/maven2/org/flywaydb/flyway-commandline"
    flyway_dir="/tmp/flyway-${version}"
    flyway_bin="${flyway_dir}/flyway"

    if [[ -x "${flyway_bin}" ]]; then
        echo "INFO: Flyway ${version} already downloaded. Skipping..."
    else
        echo "INFO: Setting up flyway ${version}"
        wget --no-clobber --no-verbose "${base_url}/${version}/flyway-commandline-${version}-linux-x64.tar.gz" \
            --output-document="/tmp/flyway-commandline-${version}-linux-x64.tar.gz" && \
        tar --extract --gzip --file="/tmp/flyway-commandline-${version}-linux-x64.tar.gz" --directory="/tmp"
    fi

    # Create a symbolic link if not already linked.
    if ! command -v flyway >/dev/null 2>&1; then
        ln -s "${flyway_bin}" /usr/bin/flyway
    fi

    flyway -url="jdbc:postgresql://${dbhost}:${dbport}/${dbname}" \
        -user="${dbuser}" \
        -password="${dbpassword}" \
        -locations="filesystem:${directory}" \
        -schemas="public" \
        -placeholderReplacement="false" \
        -postgresql.transactional.lock="false" \
        migrate
}

run_go_migrate() {
    base_url="https://github.com/golang-migrate/migrate/releases/download"
    go_migrate_dir="/tmp/migrate-v${version}"
    go_migrate_bin="${go_migrate_dir}/migrate"

    if [[ -x "${go_migrate_bin}" ]]; then
        echo "INFO: Go-migrate v${version} already downloaded. Skipping..."
    else
        echo "INFO: Setting up go-migrate v${version}"
        wget --no-clobber --no-verbose "${base_url}/v${version}/migrate.linux-amd64.tar.gz" \
            --output-document="/tmp/migrate-v${version}.linux-amd64.tar.gz" && \
        mkdir -p "${go_migrate_dir}" && \
        tar --extract --gzip --file="/tmp/migrate-v${version}.linux-amd64.tar.gz" --directory="${go_migrate_dir}"
    fi

    # Create a symbolic link if not already linked.
    if ! command -v migrate >/dev/null 2>&1; then
        ln -s "${go_migrate_bin}" /usr/bin/migrate
    fi

    migrate -path "${directory}" -database "postgres://${dbuser}:${dbpassword}@${dbhost}:${dbport}/${dbname}" up
}

run_dbmate() {
    base_url="https://github.com/amacneil/dbmate/releases/download"
    dbmate_bin="/tmp/dbmate-v${version}"

    if [[ -x "${dbmate_bin}" ]]; then
        echo "INFO: Dbmate v${version} already downloaded. Skipping..."
    else
        echo "INFO: Setting up dbmate v${version}"
        wget --no-clobber --no-verbose "${base_url}/v${version}/dbmate-linux-amd64" \
            --output-document="${dbmate_bin}" && \
        chmod +x "${dbmate_bin}"
    fi

    # Create a symbolic link if not already linked.
    if ! command -v dbmate >/dev/null 2>&1; then
        ln -s "${dbmate_bin}" /usr/bin/dbmate
    fi

    dbmate --migrations-dir "${directory}" --url "postgres://${dbuser}:${dbpassword}@${dbhost}:${dbport}/${dbname}" up
}

run_goose() {
    base_url="https://github.com/pressly/goose/releases/download"
    goose_bin="/tmp/goose-v${version}"

    if [[ -x "${goose_bin}" ]]; then
        echo "INFO: Goose v${version} already downloaded. Skipping..."
    else
        echo "INFO: Setting up goose v${version}"
        wget --no-clobber --no-verbose "${base_url}/v${version}/goose_linux_x86_64" \
            --output-document="${goose_bin}" && \
        chmod +x "${goose_bin}"
    fi

    # Create a symbolic link if not already linked.
    if ! command -v goose >/dev/null 2>&1; then
        ln -s "${goose_bin}" /usr/bin/goose
    fi

    goose postgres  "postgres://${dbuser}:${dbpassword}@${dbhost}:${dbport}/${dbname}" -dir "${directory}" up
}

if [[ "${tool}" == "flyway" ]]; then
    run_flyway
elif [[ "${tool}" == "go-migrate" ]]; then
    run_go_migrate
elif [[ "${tool}" == "dbmate" ]]; then
    run_dbmate
elif [[ "${tool}" == "goose" ]]; then
    run_goose
else
    echo "ERROR: Unsupported migration tool: ${tool}"
    exit 1
fi
