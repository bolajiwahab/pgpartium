#!/bin/bash

usage() {
    echo "
    ${0##*/}

    Apply database migrations.

    OPTIONS:
      -m  the directory to the migration files (Required)
      -t  the migration tool (Required)
      -v  the migration tool version (Required)
      -u  the database username (Default: postgres)
      -w  the database password (Default: postgres)
      -s  the database host (Default: localhost)
      -p  the database port (Default: 5432)
      -d  the database name (Default: postgres)
      -h  show this help message.

    SAMPLE USAGE:
        ${0##*/} -m \"migrations\" -t flyway -v 11.8.0
        ${0##*/} -m \"migrations\" -t flyway -v 11.8.0 -u user -w password -s host -p port -d database
"
}

while getopts "m:t:v:u:w:s:p:d:h" option; do
    case "${option}" in
    m)
        directory="${OPTARG}"
        ;;
    t)
        tool="${OPTARG}"
        ;;
    v)
        version="${OPTARG}"
        ;;
    u)
        dbuser="${OPTARG}"
        ;;
    w)
        dbpassword="${OPTARG}"
        ;;
    s)
        dbhost="${OPTARG}"
        ;;
    p)
        dbport="${OPTARG}"
        ;;
    d)
        dbname="${OPTARG}"
        ;;
    h | *)
        usage
        exit 0
        ;;
    esac
done

set -euo pipefail

config=${config:-}
dbuser=${dbuser:-postgres}
dbpassword=${dbpassword:-postgres}
dbhost=${dbhost:-localhost}
dbport=${dbport:-5432}
dbname=${dbname:-postgres}

# Ensure required parameters are provided.
if [[ -z "${directory}" || -z "${tool}" || -z "${version}" ]]; then
    usage
    exit 1
fi

run_flyway() {
    base_url="https://repo1.maven.org/maven2/org/flywaydb/flyway-commandline"
    flyway_dir="/tmp/flyway-${version}"
    flyway_bin="${flyway_dir}/flyway"

    if [[ -x "${flyway_bin}" ]]; then
        echo "INFO: Flyway ${version} already set up. Skipping..."
    else
        echo "INFO: Setting up flyway ${version}"
        wget --no-clobber --no-verbose "${base_url}/${version}/flyway-commandline-${version}-linux-x64.tar.gz" \
            --output-document="/tmp/flyway-commandline-${version}-linux-x64.tar.gz" && \
        tar --extract --gzip --file="/tmp/flyway-commandline-${version}-linux-x64.tar.gz" --directory="/tmp"
    fi

    # Create a symbolic link if not already linked.
    if ! command -v flyway >/dev/null 2>&1; then
        ln -s "${flyway_bin}" /usr/bin/flyway
    fi

    flyway -url="jdbc:postgresql://${dbhost}:${dbport}/${dbname}" \
           -user="${dbuser}" \
           -password="${dbpassword}" \
           -locations="filesystem:${directory}" \
           -schemas="public" \
           migrate
}

if [[ "${tool}" == "flyway" ]]; then
    run_flyway
fi
