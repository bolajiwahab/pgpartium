#!/bin/bash

usage() {
    cat <<-EOF
    ${0##*/}

    Creates or updates a pull request on github.

    OPTIONS:
      -b  the branch name to use
      -t  the title of the pull request
      -m  the commit message
      -h  show this help message.

    SAMPLE USAGE:
        ${0##*/} -b generate-partitions
EOF
}

while getopts "b:t:m:h" option; do
    case "${option}" in
    b)
        branch="${OPTARG}"
        ;;
    t)
        title="${OPTARG}"
        ;;
    m)
        commit_msg="${OPTARG}"
        ;;
    h | *)
        usage
        exit 0
        ;;
    esac
done

set -euo pipefail

branch=${branch:-"add-expire-partitions"}
title=${title:-"Add/Expire partitions"}
commit_msg=${commit_msg:-"${title}"}

if git diff --quiet -- && [ -z "$(git ls-files --others --exclude-standard)" ]; then
    echo "INFO: No changes detected. Exiting..."
    exit 0
fi

# if ! gh auth status &>/dev/null; then
#     echo "ERROR: ❌ GitHub CLI is not authenticated. Run 'gh auth login'." >&2
#     exit 1
# fi

full_branch="pgpartium/${branch}"
base_branch=$(git remote show origin | grep 'HEAD branch' | awk '{print $NF}')

# Set up git config
git config --global user.email "github-actions[bot]@users.noreply.github.com"
git config --global user.name "github-actions[bot]"

# Ensure we have the latest remote info
git fetch origin "${base_branch}"
# git checkout "${base_branch}"

git checkout -b new_branch from_branch

# Always create/reset our branch from HEAD to retain untracked files
git checkout -b "$full_branch" "${base_branch}"

git add -A
git commit -m "${commit_msg}"

# Push to remote
git push origin "${full_branch}" --force

PR_URL="$(gh pr list --head "${full_branch}" --state open --json url --jq .[].url)"
if [[ -n "${PR_URL}" ]]; then
    echo "INFO: PR already exists -> ${PR_URL}. Exiting..."
    exit 0
else
    echo "INFO: Creating PR"
    gh pr create --base "${base_branch}" \
        --head "${full_branch}" \
        --title "${title}" \
        --body "This PR adds/expires partitions."
fi
