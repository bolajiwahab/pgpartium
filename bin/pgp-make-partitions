#!/bin/bash

usage() {
    echo "
    ${0##*/}

    Generates partitions for partitioned tables.

    OPTIONS:
    -c  the config file in yaml (Required)
    -u  the database username (Default: postgres)
    -w  the database password (Default: postgres)
    -s  the database host (Default: localhost)
    -p  the database port (Default: 5432)
    -d  the database name (Default: postgres)
    -h  show this help message.

    SAMPLE USAGE:
        ${0##*/} -c config.yaml
        ${0##*/} -c config.yaml -u user -w password -s host -p port -d database
"
}

while getopts "c:u:w:s:p:d:h" option; do
    case "${option}" in
    c)
        config="${OPTARG}"
        ;;
    u)
        dbuser="${OPTARG}"
        ;;
    w)
        dbpassword="${OPTARG}"
        ;;
    s)
        dbhost="${OPTARG}"
        ;;
    p)
        dbport="${OPTARG}"
        ;;
    d)
        dbname="${OPTARG}"
        ;;
    h | *)
        usage
        exit 0
        ;;
    esac
done

set -euo pipefail

config=${config:-}
dbuser=${dbuser:-postgres}
dbpassword=${dbpassword:-postgres}
dbhost=${dbhost:-localhost}
dbport=${dbport:-5432}
dbname=${dbname:-postgres}

# Ensure config is provided.
if [[ -z "${config}" ]]; then
    usage
    exit 1
fi

# Validate schema.
jsonschema schema.json <<< "$(yq -o=json "${config}")"

# Set defaults.
export DEFAULT_TABLESPACE="pg_default"
export DEFAULT_PAST=0
export DEFAULT_FUTURE=0
export DEFAULT_RETENTION="-1"
export DEFAULT_CREATE_DEFAULT=false
export DEFAULT_SKIP_OVERLAPPING=false
export DEFAULT_STORAGE_PARAMETERS="{}"
export DEFAULT_TIMEZONE="Etc/UTC"

# Extract global configs.
GLOBAL_PARTITION_SCHEMA=$(yq '.generates.partition_schema' "${config}")
GLOBAL_PARTITION_NAME_TEMPLATE=$(yq '.generates.name_template' "${config}")
GLOBAL_PAST=$(yq '.generates.past // strenv(DEFAULT_PAST)' "${config}")
GLOBAL_FUTURE=$(yq '.generates.future // strenv(DEFAULT_FUTURE)' "${config}")
GLOBAL_INTERVAL=$(yq '.generates.interval' "${config}")
GLOBAL_RETENTION=$(yq '.generates.retention // strenv(DEFAULT_RETENTION)' "${config}")
GLOBAL_CREATE_DEFAULT=$(yq '.generates.create_default // strenv(DEFAULT_CREATE_DEFAULT)' "${config}")
GLOBAL_DEFAULT_PARTITION_NAME_TEMPLATE=$(yq '.generates.default_partition_name_template' "${config}")
GLOBAL_SKIP_OVERLAPPING=$(yq '.generates.skip_overlapping // strenv(DEFAULT_SKIP_OVERLAPPING)' "${config}")
GLOBAL_PARTITION_TABLESPACE=$(yq '.generates.partition_tablespace // strenv(DEFAULT_TABLESPACE)' "${config}")
GLOBAL_STORAGE_PARAMETERS=$(yq -o=json '.generates.storage_parameters // (strenv(DEFAULT_STORAGE_PARAMETERS) | fromjson)' "${config}")
GLOBAL_TIMEZONE=$(yq '.generates.timezone // strenv(DEFAULT_TIMEZONE)' "${config}")

export GLOBAL_PARTITION_TABLESPACE GLOBAL_PARTITION_SCHEMA GLOBAL_PARTITION_NAME_TEMPLATE GLOBAL_PAST GLOBAL_FUTURE GLOBAL_INTERVAL \
    GLOBAL_RETENTION GLOBAL_DEFAULT_PARTITION_NAME_TEMPLATE GLOBAL_SKIP_OVERLAPPING \
    GLOBAL_STORAGE_PARAMETERS GLOBAL_TIMEZONE

GLOBAL_INDEX_TABLESPACE=$(yq '.generates.index_tablespace // strenv(GLOBAL_PARTITION_TABLESPACE)' "${config}")

export GLOBAL_INDEX_TABLESPACE

directory=$(yq '.generates.directory' "${config}")
tool=$(yq '.generates.migration-tool.name' "${config}")
version=$(yq '.generates.migration-tool.version' "${config}")

declare -A failed_tables=()

# Staging area.
temp_migration_directory=$(mktemp -d)
temp_error_directory=$(mktemp -d)

# Stage current migrations in staging area.
echo "INFO: Staging current migrations"
cp -a "${directory}/." "${temp_migration_directory}/"

cleanup() {
    rm -rf "${temp_migration_directory}"
    rm -rf "${temp_error_directory}"
}

trap cleanup EXIT ERR

# Setup infrastructure.
echo "INFO: Setting up infrastructure"
pgp-setup-infra -u "${dbuser}" -w "${dbpassword}" -s "${dbhost}" -p "${dbport}" -d "${dbname}"

echo "INFO: Applying current migrations"
pgp-migrate -m "${directory}" -t "${tool}" -v "${version}" -u "${dbuser}" -w "${dbpassword}" -s "${dbhost}" -p "${dbport}" -d "${dbname}"
echo "INFO: Current migrations applied"

# Process each partitioned table.
while read -r table; do
    table_schema=$(yq '.table_schema' <<< "${table}")
    table_name=$(yq '.table_name' <<< "${table}")
    file_name_template=$(yq '.file_name_template' <<< "${table}")
    description=$(yq '.description.make // "Add partitions for {table_schema}_{table_name}"' <<< "${table}")
    # Replace table_schema and table_name placeholders in the description.
    description="${description//\{table_schema\}/$table_schema}"
    description="${description//\{table_name\}/$table_name}"

    output_filename=$(pgp-get-migration-filename -t "${file_name_template}" -d "${temp_migration_directory}" -m "${description}")
    echo "INFO: Making partitions for ${table_schema}.${table_name}"

    partition_schema=$(yq '.partition.partition_schema // strenv(GLOBAL_PARTITION_SCHEMA)' <<< "${table}")
    # If no schema is provided either in the partition config or in the global config, default to table schema.
    if [[ "${partition_schema}" == "null" ]]; then
        partition_schema="${table_schema}"
    fi

    partition_name_template=$(yq '.partition.name_template // strenv(GLOBAL_PARTITION_NAME_TEMPLATE)' <<< "${table}")
    if [[ "${partition_name_template}" == "null" ]]; then
        echo "ERROR: Partition name template is required." >&2
        echo "HINT: Please provide a partition name template in the config file either in the partition config or in the global config." >&2
        exit 1
    fi

    partition_tablespace=$(yq '.partition.partition_tablespace // strenv(GLOBAL_PARTITION_TABLESPACE)' <<< "${table}")
    index_tablespace=$(yq '.partition.index_tablespace // strenv(GLOBAL_INDEX_TABLESPACE)' <<< "${table}")

    partition_interval=$(yq '.partition.interval // strenv(GLOBAL_INTERVAL)' <<< "${table}")
    if [[ "${partition_interval}" == "null" ]]; then
        echo "ERROR: Partition interval is required." >&2
        echo "HINT: Please provide a partition interval in the config file either in the partition config or in the global config." >&2
        exit 1
    fi

    past_partitions=$(yq '.partition.past // strenv(GLOBAL_PAST)' <<< "${table}")
    future_partitions=$(yq '.partition.future // strenv(GLOBAL_FUTURE)' <<< "${table}")
    retention=$(yq '.partition.retention // strenv(GLOBAL_RETENTION)' <<< "${table}")
    timezone=$(yq '.partition.timezone // strenv(GLOBAL_TIMEZONE)' <<< "${table}")
    # Because yq default value operator is used to provide alternative (or default) values
    # when a particular expression is either null or false, we cannot use it here since create_default is boolean
    # and we need to override it only when it is not set.
    create_default=$(yq '.partition.create_default' <<< "${table}")
    if [[ "${create_default}" == "null" ]]; then
        create_default="${GLOBAL_CREATE_DEFAULT}"
    fi
    # If create_default is true, default_partition_name_template is required.
    default_partition_name_template=$(yq '.partition.default_partition_name_template // strenv(GLOBAL_DEFAULT_PARTITION_NAME_TEMPLATE)' <<< "${table}")
    if [[ "${create_default}" == true && "${default_partition_name_template}" == "null" ]]; then
        echo "ERROR: Default partition name template is required when create_default is true." >&2
        echo "HINT: Please provide a default partition name template in the config file either in the partition config or in the global config." >&2
        exit 1
    fi

    skip_overlapping=$(yq '.partition.skip_overlapping // strenv(GLOBAL_SKIP_OVERLAPPING)' <<< "${table}")
    storage_parameters=$(yq '.partition.storage_parameters // strenv(GLOBAL_STORAGE_PARAMETERS)' <<< "${table}")

    template_table=$(yq '.template_table' <<< "${table}")

    if [[ "${template_table}" == "DEFAULT_PARTITION" ]]; then
        IFS=',' read -r template_table_schema template_table_name < <(
            PGPASSWORD="${dbpassword}" psql --username="${dbuser}" \
                --dbname="${dbname}" \
                --host="${dbhost}" \
                --port="${dbport}" \
                --tuples-only \
                --no-align \
                --quiet \
                --csv \
                -v "ON_ERROR_STOP=1" \
                -v table_schema="${table_schema}" \
                -v table_name="${table_name}" \
                <<EOF
SELECT partition_schema
     , partition_name
  FROM pgpartium.get_default_partition(p_table_schema=>:'table_schema', p_table_name=>:'table_name')
EOF
        ) || {
            echo "ERROR: Default partition for table ${table_schema}.${table_name} not found." >&2
            exit 1
        }

    elif [[ "${template_table}" == "LATEST_PARTITION" ]]; then
        IFS=',' read -r template_table_schema template_table_name < <(
            PGPASSWORD="${dbpassword}" psql --username="${dbuser}" \
                --dbname="${dbname}" \
                --host="${dbhost}" \
                --port="${dbport}" \
                --tuples-only \
                --no-align \
                --quiet \
                --csv \
                -v "ON_ERROR_STOP=1" \
                -v table_schema="${table_schema}" \
                -v table_name="${table_name}" \
                <<EOF
SELECT partition_schema
     , partition_name
  FROM pgpartium.get_latest_partition(p_table_schema=>:'table_schema', p_table_name=>:'table_name')
EOF
        ) || {
            echo "ERROR: Latest partition for table ${table_schema}.${table_name} not found." >&2
            exit 1
        }

    elif [[ "${template_table}" == "CURRENT_PARTITION" ]]; then
        IFS=',' read -r template_table_schema template_table_name < <(
            PGPASSWORD="${dbpassword}" psql --username="${dbuser}" \
                --dbname="${dbname}" \
                --host="${dbhost}" \
                --port="${dbport}" \
                --tuples-only \
                --no-align \
                --quiet \
                --csv \
                -v "ON_ERROR_STOP=1" \
                -v table_schema="${table_schema}" \
                -v table_name="${table_name}" \
                <<EOF
SELECT partition_schema
     , partition_name
  FROM pgpartium.get_current_partition(p_table_schema=>:'table_schema', p_table_name=>:'table_name')
EOF
        ) || {
            echo "ERROR: Current partition for table ${table_schema}.${table_name} not found." >&2
            exit 1
        }

    else
        template_table_schema=$(yq '.table_schema // ""' <<< "${template_table}")
        template_table_name=$(yq '.table_name // ""' <<< "${template_table}")

    fi

    error_file="${temp_error_directory}/${table_schema}.${table_name}.error"

    if ! PGPASSWORD="${dbpassword}" psql --username="${dbuser}" \
        --dbname="${dbname}" \
        --host="${dbhost}" \
        --port="${dbport}" \
        --tuples-only \
        --no-align \
        --quiet \
        -v "ON_ERROR_STOP=1" \
        -v table_schema="${table_schema}" \
        -v table_name="${table_name}" \
        -v partition_name_template="${partition_name_template}" \
        -v partition_interval="${partition_interval}" \
        -v past_partitions="${past_partitions}" \
        -v future_partitions="${future_partitions}" \
        -v create_default_partition="${create_default}" \
        -v default_partition_name_template="${default_partition_name_template}" \
        -v partition_schema="${partition_schema}" \
        -v partition_tablespace="${partition_tablespace}" \
        -v index_tablespace="${index_tablespace}" \
        -v storage_parameters="${storage_parameters}" \
        -v template_table_schema="${template_table_schema}" \
        -v template_table_name="${template_table_name}" \
        -v retention="${retention}" \
        -v timezone="${timezone}" \
        -v skip_overlapping="${skip_overlapping}" \
        --output="${temp_migration_directory}/${output_filename}" \
        2>"${error_file}" \
        <<EOF
SELECT *
  FROM pgpartium.make_partitions(
    p_table_schema=>:'table_schema'
  , p_table_name=>:'table_name'
  , p_partition_name_template=>:'partition_name_template'
  , p_interval=>:'partition_interval'
  , p_past=>:'past_partitions'
  , p_future=>:'future_partitions'
  , p_create_default=>:'create_default_partition'
  , p_default_partition_name_template=>:'default_partition_name_template'
  , p_partition_schema=>:'partition_schema'
  , p_partition_tablespace=>:'partition_tablespace'
  , p_index_tablespace=>:'index_tablespace'
  , p_storage_parameters=>:'storage_parameters'
  , p_template_table_schema=>:'template_table_schema'
  , p_template_table_name=>:'template_table_name'
  , p_retention=>:'retention'
  , p_timezone=>:'timezone'
  , p_skip_overlapping=>:'skip_overlapping'
)
EOF

    then
        failed_tables["${table_schema}.${table_name}"]=$(<"${error_file}")
        continue
    fi

    if [[ -s "${temp_migration_directory}/${output_filename}" ]]; then
        # PSQL sadly adds an empty line at the end, so remove it
        sed -i -e '${/^$/d;}' "${temp_migration_directory}/${output_filename}"
        echo "INFO: Made partitions for ${table_schema}.${table_name}"
    else
        echo "INFO: No partitions made for ${table_schema}.${table_name}"
        rm "${temp_migration_directory}/${output_filename}"
    fi

done < <(yq '.generates.tables[] | @json' "${config}")

if [ ${#failed_tables[@]} -gt 0 ]; then
    echo "ERROR: failed for ${#failed_tables[@]} table(s):" 2>&1
    for table in "${!failed_tables[@]}"; do
        echo "  '${table}': ${failed_tables[${table}]}" 2>&1
    done
    exit 1
else
    cp -rf "${temp_migration_directory}/." "${directory}/"
fi
