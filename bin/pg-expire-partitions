#!/bin/bash

usage() {
    cat <<-EOF
    ${0##*/}

    Generates partitions for partitioned tables.

    OPTIONS:
    -c  the config file in yaml (Required)
    -h  show this help message.

    SAMPLE USAGE:
        ${0##*/} -c config.yaml
EOF
}

while getopts "c:h" option; do
    case "${option}" in
    c)
        config="${OPTARG}"
        ;;
    h | *)
        usage
        exit 0
        ;;
    esac
done

set -euo pipefail

config=${config:-}

# Ensure config is provided
if [[ -z "${config}" ]]; then
    usage
    exit 1
fi

# # Setup infrastructure
pg-setup-infra

# Validate schema
yq -o=json '.' "${config}" | jsonschema schema.json

# nodename='sub_node' yq '.node[strenv(nodename)]' example.yaml

# Set defaults
export DEFAULT_RETENTION='-1'
export DEFAULT_TIMEZONE="UTC"

# Extract global configs
GLOBAL_RETENTION=$(yq '.generates[].retention // strenv(DEFAULT_RETENTION)' "${config}")
GLOBAL_TIMEZONE=$(yq '.generates[].timezone // strenv(DEFAULT_TIMEZONE)' "${config}")

export GLOBAL_RETENTION GLOBAL_TIMEZONE

directory=$(yq '.generates[].directory' "${config}")

# Process each partitioned table
yq '.generates[].tables[] | @json' "${config}" | while read -r table; do
    table_schema=$(echo "${table}" | yq '.table_schema')
    table_name=$(echo "${table}" | yq '.table_name')
    retention=$(echo "${table}" | yq '.partition.retention // strenv(GLOBAL_RETENTION)')
    timezone=$(echo "${table}" | yq '.partition.timezone // strenv(GLOBAL_TIMEZONE)')
    output_filename="${table_name}_expired_partitions.sql"

    echo "Generating expired partitions for ${table_schema}.${table_name} in ${directory}"

    psql --username=postgres \
        --dbname=postgres \
        --tuples-only \
        --no-align \
        --quiet \
        --echo-queries \
        -v "ON_ERROR_STOP=1" \
        -v table_schema="${table_schema}" \
        -v table_name="${table_name}" \
        -v retention="${retention}" \
        -v timezone="${timezone}" \
        --output="/tmp/${output_filename}" \
        <<EOF
SELECT *
  FROM pgpartium.expire_partitions(
    :'table_schema'
  , :'table_name'
  , :'retention'
  , :'timezone'
)
EOF

    # If file is not empty, move it to directory
    if [[ -s "/tmp/${output_filename}" ]]; then
        mv "/tmp/${output_filename}" "${directory}/${output_filename}"
        echo "Expired partitions for ${table_schema}.${table_name} in ${directory}/${output_filename}"
    else
        echo "No expired partitions for ${table_schema}.${table_name}"
    fi

done
