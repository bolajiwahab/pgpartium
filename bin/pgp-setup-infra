#!/bin/bash

usage() {
    echo "
    ${0##*/}

    Sets infrastruture.

    OPTIONS:
    -c  the config file in yaml (Required)
    -u  the database username (Default: postgres)
    -w  the database password (Default: postgres)
    -s  the database host (Default: localhost)
    -p  the database port (Default: 5432)
    -d  the database name (Default: postgres)
    -h  show this help message.

    SAMPLE USAGE:
        ${0##*/} -c config.yaml
        ${0##*/} -c config.yaml -u user -w password -s host -p port -d database
"
}

while getopts "c:u:w:s:p:d:h" option; do
    case "${option}" in
    c)
        config="${OPTARG}"
        ;;
    u)
        dbuser="${OPTARG}"
        ;;
    w)
        dbpassword="${OPTARG}"
        ;;
    s)
        dbhost="${OPTARG}"
        ;;
    p)
        dbport="${OPTARG}"
        ;;
    d)
        dbname="${OPTARG}"
        ;;
    h | *)
        usage
        exit 0
        ;;
    esac
done

set -euo pipefail

config=${config:-}
dbuser=${dbuser:-postgres}
dbpassword=${dbpassword:-postgres}
dbhost=${dbhost:-localhost}
dbport=${dbport:-5432}
dbname=${dbname:-postgres}

# Ensure config is provided.
if [[ -z "${config}" ]]; then
    usage
    exit 1
fi

directory=$(yq '.generates.directory' "${config}")
tool=$(yq '.generates.migration-tool.name' "${config}")
version=$(yq '.generates.migration-tool.version' "${config}")

# Setup infrastructure
find sql -type f -iname "*.sql" -print0 | sort -z | xargs -0 printf -- ' -f %s' |
    PGPASSWORD="${dbpassword}" PGOPTIONS='--client_min_messages=warning' xargs \
    psql --username="${dbuser}" \
        --dbname="${dbname}" \
        --host="${dbhost}" \
        --port="${dbport}" \
        --quiet \
        -v "ON_ERROR_STOP=1" \
        --single-transaction

run_flyway() {
    echo "INFO: Setting up flyway"
    wget --no-clobber --no-verbose "https://repo1.maven.org/maven2/org/flywaydb/flyway-commandline/${version}/flyway-commandline-${version}-linux-x64.tar.gz" \
        --output-document="/tmp/flyway-commandline-${version}-linux-x64.tar.gz" && \
    tar xzf "/tmp/flyway-commandline-${version}-linux-x64.tar.gz" -C /tmp
    ln -s "/tmp/flyway-${version}/flyway" /usr/bin/flyway
    echo "INFO: Applying current migrations"
    flyway -url="jdbc:postgresql://${dbhost}:${dbport}/${dbname}" -user="${dbuser}" -password="${dbpassword}" -locations="filesystem:${directory}" migrate
}

if [[ "${tool}" == "flyway" ]]; then
    run_flyway
fi
