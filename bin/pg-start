#!/bin/bash

usage()
{
cat <<-EOF
    ${0##*/}

    Creates a postgres cluster for a postgres version and start it.

    OPTIONS:
    -v  the postgres version to use (Required)
    -h  show this help message.

    SAMPLE USAGE:
        ${0##*/} -v 17
EOF
}

while getopts "v:h" OPTION
do
    case $OPTION in
        v)
            PGVERSION="$OPTARG"
            ;;
        h | *)
            usage
            exit 0
            ;;
    esac
done

set -eu -o pipefail

PGVERSION=${PGVERSION:-}

# Ensure version is provided
if [[ -z "$PGVERSION" ]]; then
  usage
  exit 1
fi

# Append .0 if PGVERSION is a single-digit version e.g 9
[[ $PGVERSION =~ ^[0-9]$ ]] && PGVERSION+=.0

apt.postgresql.org.sh -i -v "$PGVERSION"

pg_createcluster --start "$PGVERSION" pgpartium -- -A trust
